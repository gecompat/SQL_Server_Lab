{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-repository-foundation/upgrade-assessment.schema.json",
  "title": "AI Repository Foundation Semantic Upgrade Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "installed_version", "source_version", "source_ref", "assessments"],
  "properties": {
    "schema_version": {"const": 1},
    "installed_version": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "source_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "source_ref": {"type": "string", "minLength": 1},
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature_id", "candidate_reasons", "classification", "evidence", "rationale"],
        "properties": {
          "feature_id": {"type": "string", "minLength": 1},
          "candidate_reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "classification": {"enum": ["NOT_APPLICABLE", "ALREADY_EQUIVALENT", "PROJECT_STRONGER", "APPLY_DEFAULT", "RECOMMENDED", "DECISION_REQUIRED", "CONFLICT"]},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "rationale": {"type": "string", "minLength": 1},
          "recommendation": {"type": ["string", "null"]},
          "decision_required": {"type": ["string", "null"]},
          "selected_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
