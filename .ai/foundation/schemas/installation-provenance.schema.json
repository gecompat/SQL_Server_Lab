{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gecompat/AI_Repository_Foundation/foundation/schemas/installation-provenance.schema.json",
  "title": "Installed AI Repository Foundation provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "ruleset_version",
    "source_repository",
    "source_commit",
    "source_manifest_sha256",
    "recorded_at",
    "selection",
    "files"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract": {"const": "foundation-installation-provenance/v1"},
    "ruleset_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "source_repository": {"type": "string", "format": "uri", "minLength": 1},
    "source_commit": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        {"type": "null"}
      ]
    },
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapters", "capabilities"],
      "properties": {
        "adapters": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target",
          "kind",
          "merge",
          "source_sha256",
          "installed_sha256",
          "integration_state",
          "reason"
        ],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "merge": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "installed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "integration_state": {
            "enum": ["FOUNDATION_BASELINE", "INTENTIONAL_OVERRIDE"]
          },
          "reason": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "null"}
            ]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"integration_state": {"const": "INTENTIONAL_OVERRIDE"}}},
            "then": {"properties": {"reason": {"type": "string", "minLength": 1}}},
            "else": {"properties": {"reason": {"type": "null"}}}
          }
        ]
      }
    }
  }
}
