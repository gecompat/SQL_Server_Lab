{
  "$id": "https://example.invalid/ai-repository-foundation/provision-approval.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approved_at": {"format": "date-time", "type": "string"},
    "authority": {"const": "approve:provision"},
    "contract": {"const": "foundation-provision-approval/v1"},
    "expires_at": {"format": "date-time", "type": "string"},
    "plan_hash": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "provision_id": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "receipt_id": {"minLength": 1, "type": "string"},
    "schema_version": {"const": 1}
  },
  "required": ["schema_version", "contract", "receipt_id", "provision_id", "plan_hash", "authority", "approved_at", "expires_at"],
  "title": "Foundation exact provision approval receipt",
  "type": "object"
}
