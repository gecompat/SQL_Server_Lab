{
  "$id": "https://example.invalid/ai-repository-foundation/client-integration-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "before_sha256": {"anyOf": [{"const": "ABSENT"}, {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}]},
    "change": {"enum": ["NO_CONFIG_REQUIRED", "MANUAL_GUIDANCE", "NO_CHANGE", "MERGE_ENTRY"], "type": "string"},
    "contract": {"const": "foundation-ai-client-integration/v1"},
    "created_at": {"format": "date-time", "type": "string"},
    "detection_hash": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "expires_at": {"format": "date-time", "type": "string"},
    "executable_sha256": {"anyOf": [{"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}, {"type": "null"}]},
    "integration_id": {"minLength": 1, "type": "string"},
    "mutation": {
      "anyOf": [
        {"type": "null"},
        {
          "additionalProperties": false,
          "properties": {
            "entry": {"type": "object"},
            "entry_id": {"minLength": 1, "type": "string"},
            "root_key": {"enum": ["servers", "mcpServers"], "type": "string"}
          },
          "required": ["root_key", "entry_id", "entry"],
          "type": "object"
        }
      ]
    },
    "operation": {"const": "plan"},
    "plan_hash": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "plan_id": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "reason_codes": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
    "request_hash": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "rollback": {"minLength": 1, "type": "string"},
    "schema_version": {"const": 1},
    "selected_transport": {"enum": ["MCP", "CLI", "LAUNCHER", "SNAPSHOT", "POLICY", "MANUAL"], "type": "string"},
    "status": {"enum": ["EXECUTABLE", "MANUAL_REQUIRED", "BLOCKED"], "type": "string"},
    "unaffected_sha256": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}
  },
  "required": ["schema_version", "contract", "operation", "plan_id", "integration_id", "request_hash", "detection_hash", "created_at", "expires_at", "selected_transport", "executable_sha256", "change", "mutation", "before_sha256", "unaffected_sha256", "status", "reason_codes", "rollback", "plan_hash"],
  "title": "Foundation semantic client integration plan",
  "type": "object"
}
