ARG BASE_IMAGE=mcr.microsoft.com/mssql/server@sha256:ba4c8329f48fb8f02e1416be6a930ebfd71268caee78aa985f3af4315e457c89
ARG PYTHON_RUNTIME_IMAGE=mcr.microsoft.com/mssql/server@sha256:ba4c8329f48fb8f02e1416be6a930ebfd71268caee78aa985f3af4315e457c89
ARG R_RUNTIME_IMAGE=docker.io/rocker/r-ver@sha256:22202dfb31f3a1b515936bac559a9f56b67585adce2c14d063f97478940d374a
ARG EXTERNAL_RUNTIME_STAGE=runtime-python

FROM ${R_RUNTIME_IMAGE} AS r-runtime
USER root
COPY r-packages.lock /opt/sql-server-lab/locks/r-packages.lock
COPY install-r-runtime.sh /opt/sql-server-lab/bin/install-r-runtime.sh
RUN chmod 0755 /opt/sql-server-lab/bin/install-r-runtime.sh; \
    /opt/sql-server-lab/bin/install-r-runtime.sh /opt/sql-server-lab/locks/r-packages.lock

FROM ${PYTHON_RUNTIME_IMAGE} AS python-runtime

FROM ${BASE_IMAGE} AS runtime-base

ARG EXTENSIBILITY_DEB_URL=https://packages.microsoft.com/ubuntu/22.04/mssql-server-2022/pool/main/m/mssql-server-extensibility/mssql-server-extensibility_16.0.4265.3-1_amd64.deb
ARG EXTENSIBILITY_DEB_SHA256=50df89ac3d1176f6227a9db46d1d8128cb3a326718515082f5ca161028610226
ARG EXTENSIBILITY_DEB_VERSION=16.0.4265.3-1
ARG EXTERNAL_RUNTIME_LAUNCH_MODE=sql2022-namespace-v1
ARG OPENSSL_SONAME=3

USER root

RUN set -eux; \
    test -n "${EXTENSIBILITY_DEB_URL}"; \
    test -n "${EXTENSIBILITY_DEB_SHA256}"; \
    test -n "${EXTENSIBILITY_DEB_VERSION}"; \
    wget -q --https-only --secure-protocol=TLSv1_2 --timeout=30 --tries=3 \
        "${EXTENSIBILITY_DEB_URL}" -O /tmp/mssql-server-extensibility.deb; \
    echo "${EXTENSIBILITY_DEB_SHA256}  /tmp/mssql-server-extensibility.deb" | sha256sum --check --strict; \
    test "$(dpkg-deb -f /tmp/mssql-server-extensibility.deb Version)" = "${EXTENSIBILITY_DEB_VERSION}"; \
    dpkg --force-depends -i /tmp/mssql-server-extensibility.deb; \
    rm -f /tmp/mssql-server-extensibility.deb; \
    test "${OPENSSL_SONAME}" = '1.1' -o "${OPENSSL_SONAME}" = '3'; \
    test -e "/usr/lib/x86_64-linux-gnu/libssl.so.${OPENSSL_SONAME}"; \
    test -e "/usr/lib/x86_64-linux-gnu/libcrypto.so.${OPENSSL_SONAME}"; \
    test ! -e /usr/lib/x86_64-linux-gnu/libssl.so; \
    test ! -e /usr/lib/x86_64-linux-gnu/libcrypto.so; \
    ln -s "libssl.so.${OPENSSL_SONAME}" /usr/lib/x86_64-linux-gnu/libssl.so; \
    ln -s "libcrypto.so.${OPENSSL_SONAME}" /usr/lib/x86_64-linux-gnu/libcrypto.so; \
    test "$(readlink /usr/lib/x86_64-linux-gnu/libssl.so)" = "libssl.so.${OPENSSL_SONAME}"; \
    test "$(readlink /usr/lib/x86_64-linux-gnu/libcrypto.so)" = "libcrypto.so.${OPENSSL_SONAME}"; \
    /opt/mssql/bin/checkinstallextensibility.sh; \
    test "$(stat -c '%U:%G' /var/opt/mssql-extensibility)" = 'mssql_launchpadd:mssql_launchpadd'; \
    test "$(stat -c '%a' /var/opt/mssql-extensibility)" = '771'; \
    /opt/mssql/bin/mssql-conf set EULA accepteulaml Y

COPY launch-external-runtime.sh /opt/sql-server-lab/bin/launch-external-runtime.sh
COPY python-wheels.lock /opt/sql-server-lab/locks/python-wheels.lock
COPY install-python-runtime.sh /opt/sql-server-lab/bin/install-python-runtime.sh
COPY install-python-wheels.py /opt/sql-server-lab/bin/install-python-wheels.py

RUN chmod 0755 /opt/sql-server-lab/bin/launch-external-runtime.sh \
        /opt/sql-server-lab/bin/install-python-runtime.sh \
        /opt/sql-server-lab/bin/install-python-wheels.py

FROM runtime-base AS java-build
USER root
COPY java-artifacts.lock /opt/sql-server-lab/locks/java-artifacts.lock
COPY install-java-runtime.sh /opt/sql-server-lab/bin/install-java-runtime.sh
COPY java/SqlServerLabExternalRuntimeProbe.java /opt/sql-server-lab/java-source/SqlServerLabExternalRuntimeProbe.java
COPY java/MICROSOFT-JAVA-EXTENSION-LICENSE.txt /opt/sql-server-lab/java-source/MICROSOFT-JAVA-EXTENSION-LICENSE.txt
RUN chmod 0755 /opt/sql-server-lab/bin/install-java-runtime.sh; \
    /opt/sql-server-lab/bin/install-java-runtime.sh \
        /opt/sql-server-lab/locks/java-artifacts.lock \
        /opt/sql-server-lab/java \
        087ef4e0d1b9bee661c7fed19cbb01a17c7c2a2a341a4bc178c1205bae4d0f00 \
        e9604092b910fbc52d084d3c66ec55e3d2920cc703b382f8d4c865677b5910a0 \
        /opt/sql-server-lab/java-source/SqlServerLabExternalRuntimeProbe.java \
        /opt/sql-server-lab/java-source/MICROSOFT-JAVA-EXTENSION-LICENSE.txt

FROM runtime-base AS runtime-openmp
ARG LIBGOMP_DEB_URL=https://archive.ubuntu.com/ubuntu/pool/main/g/gcc-12/libgomp1_12.3.0-1ubuntu1~22.04.3_amd64.deb
ARG LIBGOMP_DEB_SHA256=870c27299185a5dd4accad3b15bf82a7409fd7073cccaa8025875307da4d0ce2
ARG LIBGOMP_DEB_VERSION=12.3.0-1ubuntu1~22.04.3
RUN set -eux; \
    wget -q --https-only --secure-protocol=TLSv1_2 --timeout=30 --tries=3 \
        "${LIBGOMP_DEB_URL}" -O /tmp/libgomp1.deb; \
    echo "${LIBGOMP_DEB_SHA256}  /tmp/libgomp1.deb" | sha256sum --check --strict; \
    test "$(dpkg-deb -f /tmp/libgomp1.deb Version)" = "${LIBGOMP_DEB_VERSION}"; \
    mkdir -p /opt/sql-server-lab/runtime-libraries/libgomp1; \
    dpkg-deb -x /tmp/libgomp1.deb /opt/sql-server-lab/runtime-libraries/libgomp1; \
    rm -f /tmp/libgomp1.deb; \
    test -e /opt/sql-server-lab/runtime-libraries/libgomp1/usr/lib/x86_64-linux-gnu/libgomp.so.1

FROM runtime-base AS runtime-python
COPY --from=python-runtime /usr/bin/python3.10 /usr/bin/python3.10
COPY --from=python-runtime /usr/lib/python3.10 /usr/lib/python3.10
COPY --from=runtime-openmp /opt/sql-server-lab/runtime-libraries/libgomp1/usr/lib/x86_64-linux-gnu/libgomp.so.1* /usr/lib/x86_64-linux-gnu/
RUN set -eux; \
    /opt/sql-server-lab/bin/install-python-runtime.sh /opt/sql-server-lab/locks/python-wheels.lock; \
    test -e /usr/lib/x86_64-linux-gnu/libgomp.so.1; \
    /opt/mssql/bin/mssql-conf set extensibility pythonbinpath /usr/bin/python3.10; \
    /opt/mssql/bin/mssql-conf set extensibility datadirectories /usr/lib:/usr/lib/python3.10/dist-packages

FROM runtime-base AS runtime-r
COPY --from=r-runtime /usr/local/lib/R /usr/local/lib/R
COPY --from=r-runtime /usr/local/bin/R /usr/local/bin/R
COPY --from=r-runtime /usr/local/bin/Rscript /usr/local/bin/Rscript
COPY --from=r-runtime /usr/lib/x86_64-linux-gnu/openblas-pthread /usr/lib/x86_64-linux-gnu/openblas-pthread
COPY --from=r-runtime /usr/lib/x86_64-linux-gnu/libgfortran.so.5* /usr/lib/x86_64-linux-gnu/
COPY --from=r-runtime /usr/lib/x86_64-linux-gnu/libquadmath.so.0* /usr/lib/x86_64-linux-gnu/
COPY --from=runtime-openmp /opt/sql-server-lab/runtime-libraries/libgomp1/usr/lib/x86_64-linux-gnu/libgomp.so.1* /usr/lib/x86_64-linux-gnu/
COPY --from=r-runtime /usr/lib/x86_64-linux-gnu/libtirpc.so.3* /usr/lib/x86_64-linux-gnu/
COPY --from=r-runtime /usr/lib/x86_64-linux-gnu/libicudata.so.70* /usr/lib/x86_64-linux-gnu/
COPY --from=r-runtime /usr/lib/x86_64-linux-gnu/libicui18n.so.70* /usr/lib/x86_64-linux-gnu/
COPY --from=r-runtime /usr/lib/x86_64-linux-gnu/libicuuc.so.70* /usr/lib/x86_64-linux-gnu/
RUN set -eux; \
    ln -s openblas-pthread/libblas.so.3 /usr/lib/x86_64-linux-gnu/libblas.so.3; \
    ln -s openblas-pthread/libopenblasp-r0.3.20.so /usr/lib/x86_64-linux-gnu/libopenblas.so.0; \
    ln -s openblas-pthread/liblapack.so.3 /usr/lib/x86_64-linux-gnu/liblapack.so.3; \
    Rscript --vanilla -e 'stopifnot(getRversion() == "4.2.3", as.character(packageVersion("RevoScaleR")) == "10.0.1")'; \
    /opt/mssql/bin/mssql-conf set extensibility rbinpath /usr/local/lib/R/bin/R; \
    /opt/mssql/bin/mssql-conf set extensibility datadirectories /usr/local/lib/R

FROM runtime-r AS runtime-r-python
COPY --from=python-runtime /usr/bin/python3.10 /usr/bin/python3.10
COPY --from=python-runtime /usr/lib/python3.10 /usr/lib/python3.10
RUN set -eux; \
    /opt/sql-server-lab/bin/install-python-runtime.sh /opt/sql-server-lab/locks/python-wheels.lock; \
    /opt/mssql/bin/mssql-conf set extensibility pythonbinpath /usr/bin/python3.10; \
    /opt/mssql/bin/mssql-conf set extensibility datadirectories /usr/local/lib/R:/usr/lib:/usr/lib/python3.10/dist-packages

FROM runtime-base AS runtime-java
COPY --from=java-build --chown=mssql:root /opt/sql-server-lab/java /opt/sql-server-lab/java
RUN /opt/sql-server-lab/java/jre/bin/java -version; \
    test ! -e /opt/sql-server-lab/java/jre/bin/javac; \
    test -x /opt/sql-server-lab/java/jre/lib/jspawnhelper; \
    /opt/mssql/bin/mssql-conf set extensibility datadirectories /opt/sql-server-lab/java

FROM runtime-r AS runtime-r-java
COPY --from=java-build --chown=mssql:root /opt/sql-server-lab/java /opt/sql-server-lab/java
RUN /opt/sql-server-lab/java/jre/bin/java -version; \
    test ! -e /opt/sql-server-lab/java/jre/bin/javac; \
    test -x /opt/sql-server-lab/java/jre/lib/jspawnhelper; \
    /opt/mssql/bin/mssql-conf set extensibility datadirectories /usr/local/lib/R:/opt/sql-server-lab/java

FROM runtime-python AS runtime-python-java
COPY --from=java-build --chown=mssql:root /opt/sql-server-lab/java /opt/sql-server-lab/java
RUN /opt/sql-server-lab/java/jre/bin/java -version; \
    test ! -e /opt/sql-server-lab/java/jre/bin/javac; \
    test -x /opt/sql-server-lab/java/jre/lib/jspawnhelper; \
    /opt/mssql/bin/mssql-conf set extensibility datadirectories /usr/lib:/usr/lib/python3.10/dist-packages:/opt/sql-server-lab/java

FROM runtime-r-python AS runtime-r-python-java
COPY --from=java-build --chown=mssql:root /opt/sql-server-lab/java /opt/sql-server-lab/java
RUN /opt/sql-server-lab/java/jre/bin/java -version; \
    test ! -e /opt/sql-server-lab/java/jre/bin/javac; \
    test -x /opt/sql-server-lab/java/jre/lib/jspawnhelper; \
    /opt/mssql/bin/mssql-conf set extensibility datadirectories /usr/local/lib/R:/usr/lib:/usr/lib/python3.10/dist-packages:/opt/sql-server-lab/java

FROM ${EXTERNAL_RUNTIME_STAGE} AS selected-runtime
ARG EXTERNAL_RUNTIMES=python
ARG CONTENT_ID=characterization

USER root
RUN case "${EXTERNAL_RUNTIMES}" in \
        python|r|java|r,python|r,java|python,java|r,python,java) true ;; \
        *) echo "Unsupported external runtime set: ${EXTERNAL_RUNTIMES}" >&2; exit 64 ;; \
    esac; \
    install -d -m 0755 /opt/sql-server-lab/config; \
    install -m 0644 /var/opt/mssql/mssql.conf /opt/sql-server-lab/config/external-runtime-mssql.conf

USER root

LABEL org.opencontainers.image.title="SQL Server Lab External Runtime" \
      org.opencontainers.image.vendor="SQL_Server_Lab" \
      sql-server-lab.external-runtime.contract="1.0" \
      sql-server-lab.external-runtime.image-key="${CONTENT_ID}" \
      sql-server-lab.external-runtime.languages="${EXTERNAL_RUNTIMES}" \
      sql-server-lab.external-runtime.launch-mode="${EXTERNAL_RUNTIME_LAUNCH_MODE}" \
      sql-server-lab.external-runtime.required-cgroup-version="1" \
      sql-server-lab.external-runtime.required-capabilities="CHOWN,DAC_OVERRIDE,KILL,SETGID,SETUID,SYS_ADMIN,MKNOD,SETPCAP,NET_ADMIN,NET_RAW,SYS_PTRACE" \
      sql-server-lab.external-runtime.required-security-options="apparmor=unconfined,seccomp=unconfined" \
      sql-server-lab.external-runtime.namespace-isolation="true" \
      sql-server-lab.external-runtime.outbound-access="false"

ENTRYPOINT ["/opt/sql-server-lab/bin/launch-external-runtime.sh"]
CMD ["/opt/mssql/bin/sqlservr"]
