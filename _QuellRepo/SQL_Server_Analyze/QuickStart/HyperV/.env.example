# SQL_Server_Analyze Hyper-V QuickStart Konfiguration
# Diese Datei ist ein Beispiel mit synthetischen Platzhaltern.
# Die tatsächliche .env wird von Setup.ps1 erzeugt und enthält lokale Werte.

# SQL Server Versionen (kommagetrennt: 2019,2022,2025)
SQL_VERSIONS=2022

# Ressourcenprofil: Compact | Standard | Performance
RESOURCE_PROFILE=Standard

# SA-Passwort für die synthetischen Testinstanzen
SA_PASSWORD=ExampleP@ssw0rd!Replace

# Speicherlayout: SingleRoot | SeparateRoots
STORAGE_LAYOUT=SingleRoot

# Pfad für VMs, VHDs und Steuerungsdateien
LAB_ROOT=D:\Lab\HyperV

# Base-Image Quelle: Local | Download
BASE_IMAGE_SOURCE=Local

# Pfad zum bereitgestellten Base-VHDX (nur bei BASE_IMAGE_SOURCE=Local)
BASE_VHDX_PATH=D:\Images\WindowsServer2022-Base.vhdx

# SQL Server Installationsmedien (ISO-Pfade oder 'Download')
SQL_2019_MEDIA=Download
SQL_2022_MEDIA=Download
SQL_2025_MEDIA=Download

# SQL Server Agent aktivieren
SQL_AGENT_ENABLED=true

# Framework automatisch installieren
INSTALL_FRAMEWORK=true

# Scope-ID (automatisch generiert bei Setup)
SCOPE_ID=
