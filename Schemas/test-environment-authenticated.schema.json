{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sql-server-lab.local/schemas/test-environment-authenticated.schema.json",
  "title": "SqlServerLab.TestEnvironment/2.0",
  "description": "Explicit, separately signed Windows-current-user authenticated TLS export; no automatic V1 cutover.",
  "type": "object",
  "required": [
    "$schema",
    "contractVersion",
    "generatedAt",
    "groupStatus",
    "selectionRule",
    "containsPlainTextSecrets",
    "environments",
    "qualification"
  ],
  "properties": {
    "$schema": {
      "const": "./TestUmgebung.schema.json"
    },
    "contractVersion": {
      "const": "SqlServerLab.TestEnvironment/2.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "groupStatus": {
      "enum": [
        "EMPTY",
        "READY",
        "INCOMPLETE"
      ]
    },
    "selectionRule": {
      "type": "string",
      "minLength": 1
    },
    "containsPlainTextSecrets": {
      "const": true
    },
    "environments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/environment"
      }
    },
    "qualification": {
      "type": "object",
      "required": [
        "algorithm",
        "payload",
        "signature",
        "caDer"
      ],
      "properties": {
        "payload": {
          "minLength": 1,
          "type": "string"
        },
        "algorithm": {
          "const": "RSA3072_SHA256_PKCS1"
        },
        "signature": {
          "minLength": 1,
          "type": "string"
        },
        "caDer": {
          "minLength": 1,
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "groupStatus": {
            "const": "EMPTY"
          }
        },
        "required": [
          "groupStatus"
        ]
      },
      "then": {
        "properties": {
          "environments": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "groupStatus": {
            "const": "READY"
          }
        },
        "required": [
          "groupStatus"
        ]
      },
      "then": {
        "properties": {
          "environments": {
            "minItems": 1,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/environment"
                },
                {
                  "properties": {
                    "status": {
                      "const": "READY"
                    },
                    "runtimeStatus": {
                      "const": "READY"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "groupStatus": {
            "const": "INCOMPLETE"
          }
        },
        "required": [
          "groupStatus"
        ]
      },
      "then": {
        "properties": {
          "environments": {
            "minItems": 1,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/environment"
                },
                {
                  "properties": {
                    "status": {
                      "const": "GROUP_INCOMPLETE"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment": {
      "type": "object",
      "required": [
        "key",
        "status",
        "runtimeStatus",
        "platform",
        "provider",
        "sqlVersion",
        "patch",
        "resolvedVersion",
        "runId",
        "instanceId",
        "host",
        "port",
        "database",
        "username",
        "password",
        "encrypt",
        "trustServerCertificate",
        "autoStart",
        "connectionString"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$",
          "minLength": 1
        },
        "status": {
          "enum": [
            "READY",
            "GROUP_INCOMPLETE"
          ]
        },
        "runtimeStatus": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "enum": [
            "linux",
            "windows"
          ]
        },
        "provider": {
          "anyOf": [
            {
              "enum": [
                "docker",
                "podman",
                "hyperv"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "sqlVersion": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "patch": {
          "type": "string",
          "minLength": 1,
          "description": "Neue Exporte verwenden fuer CU cu plus positive dezimale Nummer ohne fuehrende Nullen. Leser akzeptieren historische CU-Schreibweisen vor der semantischen Normalisierung; CU-Vergleich ignoriert Gross-/Kleinschreibung und verlangt dieselbe Nummer. Andere Patchbezeichnungen behalten ihre Bedeutung."
        },
        "resolvedVersion": {
          "$ref": "#/$defs/nullableString"
        },
        "runId": {
          "type": "string"
        },
        "instanceId": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "$ref": "#/$defs/nullableString"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "const": "master"
        },
        "username": {
          "const": "sa"
        },
        "password": {
          "$ref": "#/$defs/nullableString"
        },
        "encrypt": {
          "const": true
        },
        "trustServerCertificate": {
          "const": false
        },
        "autoStart": {
          "const": "off"
        },
        "connectionString": {
          "$ref": "#/$defs/nullableString"
        }
      },
      "additionalProperties": false
    }
  }
}