{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SqlServerLab.SqlObservabilityEvidence/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["ContractVersion", "Source", "ObservationStatus", "Server", "Databases", "WaitStatistics", "EvidenceBoundary", "ObservedAt"],
  "properties": {
    "ContractVersion": { "const": "SqlServerLab.SqlObservabilityEvidence/1.0" },
    "Source": {
      "type": "object", "additionalProperties": false,
      "required": ["Provider", "RunId", "InstanceId", "SqlMajorVersion"],
      "properties": {
        "Provider": { "enum": ["docker", "podman", "hyperv", "external"] },
        "RunId": { "type": ["string", "null"] },
        "InstanceId": { "type": ["string", "null"] },
        "SqlMajorVersion": { "type": "string", "pattern": "^[0-9]{2,4}$" }
      }
    },
    "ObservationStatus": { "const": "SQL_ENGINE_COMPLETE" },
    "Server": {
      "type": "object", "additionalProperties": false,
      "required": ["CpuCount", "PhysicalMemoryKb"],
      "properties": {
        "CpuCount": { "type": "integer", "minimum": 1 },
        "PhysicalMemoryKb": { "type": "integer", "minimum": 1 }
      }
    },
    "Databases": {
      "type": "object", "additionalProperties": false,
      "required": ["OnlineCount", "TotalFileSizeKb", "QueryStoreEnabledCount"],
      "properties": {
        "OnlineCount": { "type": "integer", "minimum": 0 },
        "TotalFileSizeKb": { "type": "integer", "minimum": 0 },
        "QueryStoreEnabledCount": { "type": "integer", "minimum": 0 }
      }
    },
    "WaitStatistics": {
      "type": "object", "additionalProperties": false,
      "required": ["NonSleepWaitTypeCount", "WaitingTaskCount", "WaitTimeMs"],
      "properties": {
        "NonSleepWaitTypeCount": { "type": "integer", "minimum": 0 },
        "WaitingTaskCount": { "type": "integer", "minimum": 0 },
        "WaitTimeMs": { "type": "integer", "minimum": 0 }
      }
    },
    "EvidenceBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["SqlTextIncluded", "DatabaseNamesIncluded", "LoginNamesIncluded", "HostValuesIncluded", "SecretValuesIncluded"],
      "properties": {
        "SqlTextIncluded": { "const": false },
        "DatabaseNamesIncluded": { "const": false },
        "LoginNamesIncluded": { "const": false },
        "HostValuesIncluded": { "const": false },
        "SecretValuesIncluded": { "const": false }
      }
    },
    "ObservedAt": { "type": "string", "format": "date-time" }
  }
}