{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sql-server-lab.local/schemas/hyperv-image-migration-journal.schema.json",
  "title": "SqlServerLab.HyperVImageMigrationJournal/1.0",
  "type": "object",
  "required": ["ContractVersion", "PlanId", "PlanSha256", "Status", "CurrentStep", "CreatedAt", "UpdatedAt", "CopiedArtifacts", "BindingCommitted", "SourceRetention", "SourceCleanup", "Errors"],
  "properties": {
    "ContractVersion": { "const": "SqlServerLab.HyperVImageMigrationJournal/1.0" },
    "PlanId": { "type": "string", "format": "uuid" },
    "PlanSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "Status": { "enum": ["PREPARING", "COPYING", "COMMITTING", "CLEANING", "WAITING_FOR_CONSUMERS", "RECOVERY_REQUIRED", "COMPLETED"] },
    "CopiedArtifacts": { "type": "array", "items": { "type": "string" } },
    "BindingCommitted": { "type": "boolean" },
    "SourceRetention": { "type": "array" },
    "SourceCleanup": { "type": "array", "items": { "type": "string" } },
    "Errors": { "type": "array" }
  },
  "additionalProperties": true
}
