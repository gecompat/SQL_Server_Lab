{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gecompat/SQL_Server_Lab/raw/main/Schemas/sql-server-collation-catalog.schema.json",
  "title": "SQL Server Lab collation catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogMetadata", "collations"],
  "properties": {
    "$schema": { "type": "string" },
    "catalogMetadata": {
      "type": "object", "additionalProperties": false,
      "required": ["lastVerified", "sources"],
      "properties": {
        "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } }
      }
    },
    "collations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "locale", "codePage", "lcid", "caseSensitivity", "accentSensitivity", "utf8", "status", "supportedSqlVersions"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,128}$" },
          "locale": { "type": "string", "minLength": 1 },
          "codePage": { "type": "integer", "minimum": 0 },
          "lcid": { "type": "integer", "minimum": 0 },
          "caseSensitivity": { "enum": ["CI", "CS", "BIN", "BIN2"] },
          "accentSensitivity": { "enum": ["AI", "AS", "NOT_APPLICABLE"] },
          "utf8": { "type": "boolean" },
          "status": { "enum": ["SUPPORTED", "DEPRECATED"] },
          "supportedSqlVersions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["2019", "2022", "2025"] } }
        }
      }
    }
  }
}
