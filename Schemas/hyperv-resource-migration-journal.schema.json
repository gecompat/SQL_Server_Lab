{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sql-server-lab.local/schemas/hyperv-resource-migration-journal.schema.json",
  "title": "SqlServerLab.HyperVResourceMigrationJournal/1.0",
  "type": "object",
  "required": ["ContractVersion", "PlanId", "PlanSha256", "RunId", "Status", "CurrentStep", "InitialVMStates", "CopiedDisks", "ParentReparents", "ReboundDisks", "UpdatedReferences", "BindingCommitted", "ReadinessReceipts", "SourceCleanup", "ImageMigrationResumes", "Errors"],
  "properties": {
    "ContractVersion": { "const": "SqlServerLab.HyperVResourceMigrationJournal/1.0" },
    "PlanId": { "type": "string", "format": "uuid" },
    "PlanSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "RunId": { "type": "string", "format": "uuid" },
    "Status": { "enum": ["PREPARING", "STOPPING", "COPYING", "REBINDING", "COMMITTING", "VERIFYING", "CLEANING", "COMPLETED", "RECOVERY_REQUIRED"] },
    "CurrentStep": { "type": "string" },
    "InitialVMStates": { "type": "array" },
    "CopiedDisks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["SourcePath", "DestinationPath", "SourceSha256", "TargetSha256"],
        "properties": {
          "SourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "TargetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "ParentReparents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["DestinationPath", "State", "SourceParentPath", "TargetParentPath", "SourceSha256", "TargetSha256"],
        "properties": {
          "State": { "enum": ["PENDING", "COMPLETED"] },
          "SourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "TargetSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "ReboundDisks": { "type": "array" },
    "UpdatedReferences": { "type": "array", "items": { "type": "string" } },
    "BindingCommitted": { "type": "boolean" },
    "ReadinessReceipts": { "type": "array" },
    "SourceCleanup": { "type": "array", "items": { "type": "string" } },
    "ImageMigrationResumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["PlanPath", "Status", "At"],
        "properties": { "Status": { "enum": ["WAITING_FOR_CONSUMERS", "COMPLETED"] } }
      }
    },
    "Errors": { "type": "array" }
  },
  "additionalProperties": true
}
