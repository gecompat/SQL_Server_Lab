{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gecompat/SQL_Server_Lab/raw/main/Schemas/ai-external-model-sql-plan.schema.json",
  "title": "SQL Server Lab AI External Model SQL Plan",
  "type": "object",
  "required": ["Contract","Status","EvidenceStatus","DatabaseName","SqlMajorVersion","ExternalModelName","CredentialName","OwnershipTableName","Location","ApiFormat","ModelType","RuntimeModel","Dimension","RetryCount","SourcePlanKey","EndpointReceiptKey","ValidUntilUtc","AuthenticationIdentity","CredentialSecretRequired","MutationSequence","CleanupSequence","RequiredPermissions","PendingEvidence","SqlPlanKey"],
  "properties": {
    "Contract": {"type":"object","required":["Name","Version"],"properties":{"Name":{"const":"SqlServerLab.AiExternalModelSqlPlan"},"Version":{"const":"1.0"}},"additionalProperties":false},
    "Status": {"const":"PLANNED"},
    "EvidenceStatus": {"const":"LIVE_ENDPOINT_BOUND"},
    "DatabaseName": {"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
    "SqlMajorVersion": {"const":17},
    "ExternalModelName": {"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
    "CredentialName": {"type":"string","pattern":"^https://[^/]+$"},
    "OwnershipTableName": {"type":"string","pattern":"^SqlServerLabAiOwner_[a-f0-9]{24}$"},
    "Location": {"type":"string","pattern":"^https://"},
    "ApiFormat": {"const":"OpenAI"},
    "ModelType": {"const":"EMBEDDINGS"},
    "RuntimeModel": {"type":"string","minLength":1,"maxLength":256},
    "Dimension": {"type":"integer","minimum":1,"maximum":1998},
    "RetryCount": {"const":0},
    "SourcePlanKey": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "EndpointReceiptKey": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "GatewayBindingKey": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "ValidUntilUtc": {"type":"string","format":"date-time"},
    "AuthenticationIdentity": {"const":"HTTPEndpointHeaders"},
    "CredentialSecretRequired": {"const":true},
    "MutationSequence": {"type":"array","minItems":5,"maxItems":5,"uniqueItems":true,"items":{"enum":["PREFLIGHT_DATABASE_VERSION_PERMISSIONS_AND_MASTER_KEY","CREATE_OWNERSHIP_RECEIPT","CREATE_DATABASE_SCOPED_CREDENTIAL","CREATE_EXTERNAL_MODEL","VERIFY_EXTERNAL_MODEL_CATALOG"]}},
    "CleanupSequence": {"type":"array","minItems":4,"maxItems":4,"uniqueItems":true,"items":{"enum":["DROP_EXTERNAL_MODEL","DROP_DATABASE_SCOPED_CREDENTIAL","DROP_OWNERSHIP_RECEIPT","VERIFY_SQL_OBJECTS_REMOVED"]}},
    "RequiredPermissions": {"type":"array","minItems":2,"maxItems":2,"uniqueItems":true,"items":{"enum":["CONTROL_DATABASE","CREATE_EXTERNAL_MODEL"]}},
    "PendingEvidence": {"type":"array","minItems":5,"maxItems":5,"uniqueItems":true,"items":{"enum":["SQL_EXTERNAL_MODEL_CREATED","SQL_EMBEDDING_VERIFIED","SQL_RESTART_VERIFIED","ACCELERATOR_RUNTIME_ATTESTATION","SQL_CLEANUP_VERIFIED"]}},
    "SqlPlanKey": {"type":"string","pattern":"^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
