{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SqlServerLab.PortableLabPackage/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["ContractVersion", "PackageId", "Source", "DatabasePackages", "SecretReferences", "ArtifactReferences"],
  "properties": {
    "ContractVersion": { "const": "SqlServerLab.PortableLabPackage/1.0" },
    "PackageId": { "type": "string", "format": "uuid" },
    "Source": {
      "type": "object", "additionalProperties": false,
      "required": ["Provider", "SqlMajorVersion"],
      "properties": {
        "Provider": { "enum": ["docker", "podman"] },
        "SqlMajorVersion": { "type": "string", "pattern": "^[0-9]{2,4}$" }
      }
    },
    "DatabasePackages": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["DatabasePackageId"],
        "properties": { "DatabasePackageId": { "type": "string", "format": "uuid" } }
      }
    },
    "SecretReferences": { "type": "array", "items": { "type": "string", "pattern": "^SQL_SERVER_LAB_SECRET_[A-Z0-9_]{1,96}$" }, "uniqueItems": true },
    "ArtifactReferences": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" }, "uniqueItems": true }
  }
}