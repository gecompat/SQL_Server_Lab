{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SqlServerLab.PortableLabPackage/1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["ContractVersion", "PackageId", "Source", "BackupReferences"],
  "properties": {
    "ContractVersion": { "const": "SqlServerLab.PortableLabPackage/1.1" },
    "PackageId": { "type": "string", "format": "uuid" },
    "Source": {
      "type": "object", "additionalProperties": false,
      "required": ["Provider", "SqlMajorVersion"],
      "properties": {
        "Provider": { "enum": ["docker", "podman"] },
        "SqlMajorVersion": { "type": "string", "pattern": "^[0-9]{2,4}$" }
      }
    },
    "BackupReferences": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["BackupSetId", "Sha256", "Bytes", "BackupChecksum", "RestoreVerifyOnly"],
        "properties": {
          "BackupSetId": { "type": "string", "format": "uuid" },
          "Sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "Bytes": { "type": "integer", "minimum": 1 },
          "BackupChecksum": { "type": "boolean" },
          "RestoreVerifyOnly": { "type": "boolean" }
        }
      }
    }
  }
}
