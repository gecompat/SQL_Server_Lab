{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sql-server-lab.local/schemas/database-package-attach-result.schema.json",
  "title": "SqlServerLab.DatabasePackageAttachResult/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ContractVersion",
    "Status",
    "DatabasePackageId",
    "DatabaseName",
    "TargetRunId",
    "TargetInstanceId",
    "Provider",
    "TargetBinding",
    "TargetSqlMajorVersion",
    "TargetFileStreamCapable",
    "IntegrityValidation",
    "Mode",
    "TargetCopyVerified",
    "AttachInvoked",
    "PostconditionVerified",
    "MigrationBoundary",
    "Blockers",
    "Recovery",
    "CompletedAt"
  ],
  "properties": {
    "ContractVersion": { "const": "SqlServerLab.DatabasePackageAttachResult/1.0" },
    "Status": { "enum": ["BLOCKED", "PLANNED", "ATTACHED", "RECOVERED"] },
    "DatabasePackageId": { "type": "string", "format": "uuid" },
    "DatabaseName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$" },
    "TargetRunId": { "type": "string", "minLength": 1 },
    "TargetInstanceId": { "type": "string", "minLength": 1 },
    "Provider": { "const": "hyperv" },
    "TargetBinding": { "const": "RUN_SQL_DEFAULT_DATA" },
    "TargetSqlMajorVersion": { "type": "integer", "minimum": 1 },
    "TargetFileStreamCapable": { "type": "boolean" },
    "IntegrityValidation": { "const": "VERIFIED" },
    "Mode": { "const": "COPY_THEN_ATTACH" },
    "TargetCopyVerified": { "type": "boolean" },
    "AttachInvoked": { "type": "boolean" },
    "PostconditionVerified": { "type": "boolean" },
    "MigrationBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "DependencyInventoryStatus",
        "ArtifactScope",
        "FullInstanceMigration",
        "ServerObjectsIncluded",
        "TdeKeyMaterialIncluded",
        "SecretValuesIncluded",
        "ExternalServicesIncluded",
        "DependencyCategories",
        "Warnings"
      ],
      "properties": {
        "DependencyInventoryStatus": { "enum": ["NOT_EXECUTED", "SQL_ENGINE_COMPLETE_EXTERNAL_REVIEW_REQUIRED"] },
        "ArtifactScope": { "const": "DATABASE_FILES_ONLY" },
        "FullInstanceMigration": { "const": false },
        "ServerObjectsIncluded": { "const": false },
        "TdeKeyMaterialIncluded": { "const": false },
        "SecretValuesIncluded": { "const": false },
        "ExternalServicesIncluded": { "const": false },
        "DependencyCategories": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }, "uniqueItems": true },
        "Warnings": { "type": "array", "minItems": 4, "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }, "uniqueItems": true }
      }
    },
    "Blockers": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }, "uniqueItems": true },
    "Recovery": { "enum": ["NOT_STARTED", "NOT_REQUIRED"] },
    "CompletedAt": { "type": "string", "format": "date-time" }
  }
}
