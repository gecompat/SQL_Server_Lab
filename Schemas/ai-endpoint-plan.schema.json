{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gecompat/SQL_Server_Lab/raw/main/Schemas/ai-endpoint-plan.schema.json",
  "title": "SQL Server Lab AI Endpoint Plan",
  "type": "object",
  "required": ["Contract", "Status", "Lane", "EndpointRef", "ModelKey", "Purpose", "Port", "Egress", "RequestBudget", "Blockers", "Warnings", "PlanKey"],
  "properties": {
    "Contract": {
      "type": "object",
      "required": ["Name", "Version"],
      "properties": { "Name": { "const": "SqlServerLab.AiEndpointPlan" }, "Version": { "const": "1.0" } },
      "additionalProperties": false
    },
    "Status": { "enum": ["READY", "BLOCKED", "NOT_PROBED"] },
    "Lane": { "enum": ["stub", "local", "cloud"] },
    "EndpointRef": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "TargetHost": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9.-]+$" },
    "ModelKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$" },
    "Purpose": { "enum": ["embedding", "generation"] },
    "Dimension": { "type": ["integer", "null"], "minimum": 1, "maximum": 1998 },
    "Port": { "type": ["integer", "null"], "minimum": 1024, "maximum": 65535 },
    "ServerCertificateSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "CredentialRef": { "type": ["string", "null"], "pattern": "^SQL_SERVER_LAB_SECRET_[A-Z0-9_]+$" },
    "Egress": { "enum": ["denied", "explicit"] },
    "RequestBudget": {
      "type": "object",
      "required": ["MaximumRequests", "MaximumOutputTokens", "TimeoutSeconds", "RetryCount"],
      "properties": {
        "MaximumRequests": { "type": "integer", "minimum": 1, "maximum": 100 },
        "MaximumOutputTokens": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "TimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 230 },
        "RetryCount": { "type": "integer", "minimum": 0, "maximum": 10 }
      },
      "additionalProperties": false
    },
    "Blockers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9_:.-]+$" } },
    "Warnings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9_:.-]+$" } }
    ,"PlanKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
