{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sql-server-lab/ai-runtime-capability-set.schema.json",
  "type": "object",
  "required": ["Contract","Status","EvidenceStatus","InventorySha256","RuntimeCount","Capabilities","CapabilitySetSha256"],
  "properties": {
    "Contract": {"const":"SqlServerLab.AiRuntimeCapabilitySet/1.0"},
    "Status": {"const":"COMPLETE"},
    "EvidenceStatus": {"const":"FILES_HASHED_NOT_EXECUTED"},
    "InventorySha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "RuntimeCount": {"type":"integer","minimum":1,"maximum":16},
    "Capabilities": {"type":"array","minItems":1,"maxItems":128,"items":{"$ref":"#/$defs/capability"}},
    "CapabilitySetSha256": {"type":"string","pattern":"^[a-f0-9]{64}$"}
  },
  "additionalProperties": false,
  "$defs": {
    "capability": {
      "type":"object",
      "required":["Backend","RuntimeSha256","DeviceKinds","VendorIds","MinimumDeviceCount","MaximumDeviceCount","AllowMixedKinds","Eligible","Blockers"],
      "properties": {
        "Backend":{"enum":["LlamaCppCpu","LlamaCppCuda","LlamaCppOpenVino","LlamaCppRocm","LlamaCppVulkan","LlamaCppSycl"]},
        "RuntimeSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "DeviceKinds":{"type":"array","minItems":1,"maxItems":1,"items":{"enum":["CPU","GPU","NPU"]}},
        "VendorIds":{"type":"array","minItems":1,"maxItems":1,"items":{"type":"string","pattern":"^([*]|[a-z0-9][a-z0-9._-]{0,63})$"}},
        "MinimumDeviceCount":{"const":1},
        "MaximumDeviceCount":{"type":"integer","minimum":1,"maximum":16},
        "AllowMixedKinds":{"const":false},
        "Eligible":{"type":"boolean"},
        "Blockers":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,127}$"}}
      },
      "additionalProperties":false,
      "allOf":[
        {"if":{"properties":{"Eligible":{"const":true}}},"then":{"properties":{"Blockers":{"maxItems":0}}}},
        {"if":{"properties":{"Eligible":{"const":false}}},"then":{"properties":{"Blockers":{"minItems":1}}}}
      ]
    }
  }
}
