{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gecompat/SQL_Server_Lab/raw/main/Schemas/lab-manifest.schema.json",
  "title": "SQL Server Lab Manifest",
  "description": "Schema fuer deklarative SQL-Server-Lab-Definitionen. Wird von New-SqlServerLab -Manifest verwendet.",
  "type": "object",
  "required": [
    "name",
    "instances"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Referenz auf dieses Schema (fuer IDE-Unterstuetzung)"
    },
    "name": {
      "type": "string",
      "description": "Eindeutiger Name der Lab-Umgebung",
      "minLength": 1,
      "examples": [
        "schulung-performance-2025",
        "migration-test-2022-to-2025"
      ]
    },
    "description": {
      "type": "string",
      "description": "Optionale Beschreibung der Lab-Umgebung"
    },
    "instances": {
      "type": "array",
      "description": "SQL-Server-Instanzen die erstellt werden",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/instance"
      }
    },
    "resourceOverrides": {
      "type": "object",
      "description": "Optionale Ueberschreibung der Ressourcengrenzen",
      "properties": {
        "maxMemoryMB": {
          "type": "integer",
          "minimum": 512
        },
        "maxCpus": {
          "type": "number",
          "minimum": 0.5
        },
        "skipAssessment": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "persistentData": {
      "type": "object",
      "description": "Optionale langlebige SQL-Daten je Instanz. Container verwenden ein Data-Root-Runtime-Volume; Hyper-V eine eigene Daten-VHDX.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "dataRoot": {
          "type": "string",
          "description": "Optionaler initialisierter Data Root. Ohne Wert wird der lokal gespeicherte Standard verwendet.",
          "x-ui": {
            "label": "Persistenter Data Root",
            "help": "Lokaler, zuvor initialisierter Data Root. Relative Pfade beziehen sich auf das Manifest-Verzeichnis.",
            "pathKind": "directory",
            "pathBase": "manifest-directory",
            "pathScope": "host",
            "mustExistAtPlan": false,
            "createdByRuntime": false,
            "defaultReason": "Ohne Wert wird der gespeicherte lokale Data Root verwendet."
          }
        },
        "dataDiskGB": {
          "type": "integer",
          "minimum": 32,
          "maximum": 4096,
          "default": 128,
          "description": "Größe der Daten-VHDX für Hyper-V; bei Containern nur Dokumentation der gewünschten Datenkapazität."
        }
      },
      "additionalProperties": false
    },
    "automation": {
      "type": "object",
      "description": "Unbeaufsichtigter Manifestlauf. Das Manifest referenziert nur den Namen einer durch den aufrufenden Prozess bereitgestellten Secret-Umgebungsvariablen; es enthält niemals Geheimnisse.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "unattended",
            "interactive"
          ],
          "default": "unattended",
          "description": "unattended ist der Standard für Manifeste und beendet fehlende Voraussetzungen ohne Rückfrage. interactive ist nur ein expliziter Kompatibilitätsmodus."
        },
        "secrets": {
          "type": "object",
          "description": "Optionale Referenzen auf Prozess-Umgebungsvariablen für nicht interaktive Läufe.",
          "properties": {
            "saPassword": {
              "$ref": "#/definitions/secretEnvironmentVariable"
            },
            "guestPassword": {
              "$ref": "#/definitions/secretEnvironmentVariable"
            },
            "sqlSaPassword": {
              "$ref": "#/definitions/secretEnvironmentVariable"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "expertActions": {
      "type": "object",
      "description": "Explizite Freigaben fuer erweiterte, potenziell nicht wegwerfbare Aktionen. Sie sind kein Bestandteil des Standard-Labpfads.",
      "properties": {
        "hostWriteMounts": {
          "type": "boolean",
          "default": false,
          "description": "Erlaubt schreibende beliebige Host-Mounts nur zusammen mit dem Cmdlet-Schalter -AllowExpertHostWriteMounts. Ohne beide Freigaben sind Host-Mounts schreibgeschuetzt."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "instance": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Eindeutige Instanz-ID (z.B. 'primary', 'secondary')",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
          "examples": [
            "primary",
            "secondary",
            "witness"
          ]
        },
        "version": {
          "type": "string",
          "description": "SQL-Server-Version. Formate: '2022' (latest), '2022-CU16' (spezifisches CU), '2022-CU16-ubuntu-22.04' (exakter Tag)",
          "pattern": "^\\d{4}(-CU\\d+(-[a-z0-9.-]+)?)?$",
          "examples": [
            "2019",
            "2022",
            "2022-CU16",
            "2022-CU18",
            "2025"
          ]
        },
        "provider": {
          "type": "string",
          "description": "Container-/VM-Provider (Default: auto-detect)",
          "enum": [
            "docker",
            "podman",
            "hyperv"
          ],
          "default": "docker"
        },
        "os": {
          "type": "string",
          "description": "Betriebssystem (linux fuer Container, windows fuer HyperV)",
          "enum": [
            "linux",
            "windows"
          ],
          "default": "linux"
        },
        "profile": {
          "type": "string",
          "description": "Ressourcenprofil",
          "enum": [
            "compact",
            "standard",
            "performance"
          ],
          "default": "standard"
        },
        "autostart": {
          "type": "string",
          "enum": [
            "on",
            "off"
          ],
          "default": "off",
          "description": "Startet die verwaltete Instanz nach einem Host-Neustart automatisch. Docker und Podman verwenden eine Restart-Policy und bei Desktop-/Machine-Runtimes einen Host-Startkoordinator; Hyper-V verwendet AutomaticStartAction."
        },
        "collation": {
          "type": "string",
          "description": "Default-Collation fuer Instanz und Datenbanken",
          "default": "SQL_Latin1_General_CP1_CI_AS",
          "examples": [
            "SQL_Latin1_General_CP1_CI_AS",
            "SQL_Latin1_General_CP1_CS_AS",
            "Latin1_General_CI_AS",
            "German_PhoneBook_CI_AI"
          ]
        },
        "databases": {
          "type": "array",
          "description": "Datenbanken die auf dieser Instanz erstellt/wiederhergestellt werden",
          "items": {
            "$ref": "#/definitions/database"
          }
        },
        "software": {
          "type": "array",
          "description": "Providerneutrale SQL-bezogene Software- und External-Runtime-Anforderungen",
          "items": {
            "$ref": "#/definitions/software"
          }
        },
        "postProvision": {
          "type": "array",
          "description": "T-SQL-Skripte die nach Provisioning ausgefuehrt werden (relativ zum Manifest-Verzeichnis)",
          "x-ui": {
            "label": "Post-Provisioning-Skripte",
            "help": "Diese T-SQL-Skripte werden nach der Instanz- und Datenbankbereitstellung ausgefuehrt.",
            "pathKind": "file",
            "pathBase": "manifest-directory",
            "pathScope": "host",
            "mustExistAtPlan": true,
            "createdByRuntime": false,
            "defaultReason": "Kein Default; Skripte werden nur auf ausdrueckliche Anforderung ausgefuehrt.",
            "sideEffects": "Jedes Skript veraendert die Zielinstanz und muss vor dem Plan vorhanden sein."
          },
          "items": {
            "type": "string",
            "x-ui": {
              "pathKind": "file",
              "pathBase": "manifest-directory",
              "pathScope": "host",
              "mustExistAtPlan": true,
              "createdByRuntime": false
            }
          },
          "examples": [
            [
              "setup-tables.sql",
              "seed-data.sql"
            ]
          ]
        },
        "serverConfig": {
          "$ref": "#/definitions/serverConfig"
        },
        "drives": {
          "type": "array",
          "description": "Virtuelle Laufwerke (Container-Volumes oder HyperV-VHDs). Simuliert Multi-Disk-Szenarien.",
          "items": {
            "$ref": "#/definitions/drive"
          }
        },
        "storageIntent": {
          "$ref": "lab-storage-intent.schema.json",
          "description": "Portabler SQL-Dateiplatzierungsintent. Er enthält nur Selektoren; konkrete LocationIds, Hostgeräte und Pfade werden lokal gebunden."
        },
        "hyperv": {
          "type": "object",
          "description": "Hyper-V-spezifische Bereitstellung. Ohne preparedImageId wird die höchste lokale SQL_PREPARED_SEALED-Vorlage auf Windows Server Standard Evaluation mit Desktop Experience gewählt. Passwörter gehören nie in das Manifest.",
          "properties": {
            "preparedImageId": {
              "type": "string",
              "pattern": "^hyperv-(os|sql-prepared)-sealed-[a-f0-9]{64}$",
              "description": "Artifact-ID eines lokal veröffentlichten OS_SEALED- oder SQL_PREPARED_SEALED-Images."
            },
            "switchName": {
              "type": "string",
              "description": "Optionaler vorhandener Hyper-V-Switch; ohne Wert bleibt die VM isoliert."
            },
            "memoryStartupMB": {
              "type": "integer",
              "minimum": 512,
              "maximum": 1048576,
              "default": 4096
            },
            "processorCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "default": 4
            },
            "autostart": {
              "type": "string",
              "enum": [
                "on",
                "off"
              ],
              "description": "Veralteter Kompatibilitätsalias für instances[].autostart. Wird nur verwendet, wenn der providerneutrale Wert fehlt."
            },
            "guestPasswordMode": {
              "type": "string",
              "enum": [
                "generated",
                "prompt"
              ],
              "default": "generated",
              "description": "Zufälliges Einmalpasswort anzeigen oder beim Start sicher abfragen. Das Passwort wird nicht gespeichert."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "secretEnvironmentVariable": {
      "type": "string",
      "pattern": "^SQL_SERVER_LAB_SECRET_[A-Z0-9_]+$",
      "description": "Name einer nur für den aufrufenden Prozess bereitgestellten Secret-Umgebungsvariablen. Der Wert selbst wird weder im Manifest noch im Run-State gespeichert.",
      "examples": [
        "SQL_SERVER_LAB_SECRET_SA_PASSWORD"
      ]
    },
    "database": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Datenbankname",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        },
        "collation": {
          "type": "string",
          "description": "Collation (ueberschreibt Instanz-Default)"
        },
        "files": {
          "type": "object",
          "description": "Datenbank-Dateidefinitionen (Data + Log)",
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/dbFileExtended"
              }
            },
            "log": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/dbFileExtended"
              }
            }
          },
          "additionalProperties": false
        },
        "options": {
          "type": "object",
          "description": "Datenbank-Optionen (ALTER DATABASE SET ...)",
          "properties": {
            "recoveryModel": {
              "type": "string",
              "description": "Recovery Model (bestimmt Log-Verhalten und Backup-Strategie)",
              "enum": [
                "FULL",
                "SIMPLE",
                "BULK_LOGGED"
              ],
              "default": "FULL"
            },
            "compatibility": {
              "type": "integer",
              "description": "Compatibility Level",
              "enum": [
                150,
                160,
                170
              ]
            },
            "queryStore": {
              "oneOf": [
                {
                  "type": "boolean",
                  "description": "Einfach an/aus"
                },
                {
                  "$ref": "#/definitions/queryStoreConfig"
                }
              ],
              "description": "Query Store: true/false oder detaillierte Konfiguration",
              "default": true
            },
            "autoClose": {
              "type": "boolean",
              "description": "AUTO_CLOSE (IMMER OFF fuer Server-Betrieb!)",
              "default": false
            },
            "autoShrink": {
              "type": "boolean",
              "description": "AUTO_SHRINK (IMMER OFF! Verursacht Fragmentierung)",
              "default": false
            },
            "pageVerify": {
              "type": "string",
              "description": "PAGE_VERIFY (Integritaetspruefung)",
              "enum": [
                "CHECKSUM",
                "TORN_PAGE_DETECTION",
                "NONE"
              ],
              "default": "CHECKSUM"
            },
            "rcsi": {
              "type": "boolean",
              "description": "READ_COMMITTED_SNAPSHOT (verhindert Reader-Blocking)",
              "default": false
            },
            "snapshotIsolation": {
              "type": "boolean",
              "description": "ALLOW_SNAPSHOT_ISOLATION",
              "default": false
            },
            "delayedDurability": {
              "type": "string",
              "description": "Delayed Durability (Performance vs. Durability Trade-off)",
              "enum": [
                "DISABLED",
                "ALLOWED",
                "FORCED"
              ],
              "default": "DISABLED"
            },
            "targetRecoveryTime": {
              "type": "integer",
              "description": "TARGET_RECOVERY_TIME in Sekunden (indirekte Checkpoints)",
              "minimum": 0,
              "default": 60,
              "examples": [
                10,
                30,
                60,
                120
              ]
            },
            "maxDop": {
              "type": "integer",
              "description": "Database-scoped MAXDOP (ueberschreibt Server-Setting fuer diese DB)",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "restore": {
          "type": "object",
          "description": "Backup-Restore statt CREATE DATABASE",
          "required": [
            "source"
          ],
          "properties": {
          "source": {
            "type": "string",
            "description": "HTTPS-URL oder lokaler Pfad zu einem direkten .bak-Backup",
            "x-ui": {
              "label": "Restorequelle",
              "help": "HTTP(S)-Werte werden als Downloadquelle verwendet. Lokale relative Pfade beziehen sich auf das Verzeichnis der Manifestdatei.",
              "pathKind": "file-or-url",
              "pathBase": "manifest-directory-for-local-files",
              "pathScope": "host-or-remote-artifact",
              "mustExistAtPlan": "local-file-only",
              "createdByRuntime": false,
              "defaultReason": "Kein Default; ein Restore benoetigt immer eine explizite Quelle.",
              "sideEffects": "Lokale Dateien werden gelesen; URLs werden erst durch den Restorepfad geladen und gegen eine bekannte Pruefsumme verifiziert, sofern vorhanden."
            },
              "examples": [
                "https://github.com/Microsoft/sql-server-samples/releases/download/adventureworks/AdventureWorks2022.bak",
                "C:\\Backups\\MyDB.bak"
              ]
            },
            "type": {
              "type": "string",
              "description": "Quelltyp (auto = automatische Erkennung)",
              "enum": [
                "url",
                "file",
                "auto"
              ],
              "default": "auto"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$",
              "description": "Erwartete SHA-256-Prüfsumme für einen automatisierten Remote-Restore. Ohne bekannte Prüfsumme wird ein unbeaufsichtigter Download mit TRUST_REQUIRED abgelehnt."
            },
            "replace": {
              "type": "boolean",
              "description": "WITH REPLACE verwenden (ueberschreibt existierende DB)",
              "default": true
            }
          },
          "additionalProperties": false
        },
        "sample": {
          "type": "object",
          "description": "Referenz auf eine Datenbank aus dem Sample-Katalog (Catalogs/sample-databases.json). Alternative zu 'restore' mit expliziter URL.",
          "properties": {
            "id": {
              "type": "string",
              "description": "ID aus dem Sample-Katalog",
              "examples": [
                "adventureworks-2022",
                "wideworldimporters",
                "stackoverflow-50gb"
              ]
            },
            "variant": {
              "type": "string",
              "description": "Variante (z.B. 'full', 'lightweight', 'standard', '10gb')",
              "default": "full"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dbFile": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Logischer Dateiname"
        },
        "sizeMB": {
          "type": "integer",
          "description": "Anfangsgroesse in MB",
          "minimum": 1,
          "default": 64
        },
        "filegrowthMB": {
          "type": "integer",
          "description": "Wachstumsschritt in MB",
          "minimum": 1,
          "default": 64
        }
      },
      "additionalProperties": false
    },
    "software": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Software-ID",
          "enum": [
            "ssms",
            "az-data-studio",
            "vscode",
            "sqlpackage",
            "visual-studio",
            "sql-python",
            "sql-r",
            "sql-java"
          ]
        },
        "version": {
          "type": "string",
          "description": "Gewuenschte katalogisierte Runtimeversion"
        },
        "variant": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]+$",
          "description": "Optionale exakte Variante aus dem Softwarekatalog"
        },
        "scope": {
          "type": "string",
          "enum": ["instance", "database", "sqlExternalRuntime"],
          "default": "instance"
        },
        "installMethod": {
          "type": "string",
          "enum": ["catalog", "legacy-post-start", "custom-image", "pre-built"],
          "default": "catalog"
        },
        "packages": {
          "type": "array",
          "description": "Nur im Softwarekatalog mit Version und SHA-256 gebundene Zusatzpakete",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$" },
              "version": { "type": "string" },
              "scope": { "type": "string", "enum": ["instance", "database"], "default": "instance" }
            },
            "additionalProperties": false
          }
        },
        "source": {
          "type": "string",
          "description": "Installationsquelle (winget, dotnet, url)"
        },
        "package": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "command": {
          "type": "string"
        },
        "optional": {
          "type": "boolean",
          "description": "Fehlschlag stoppt Provisierung nicht",
          "default": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": { "enum": ["sql-python", "sql-r", "sql-java"] }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "optional": { "const": false },
              "scope": { "const": "sqlExternalRuntime" }
            },
            "not": {
              "anyOf": [
                { "required": ["source"] },
                { "required": ["package"] },
                { "required": ["url"] },
                { "required": ["command"] }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "serverConfig": {
      "type": "object",
      "description": "SQL-Server-Instanzkonfiguration (sp_configure, Collation, Memory)",
      "properties": {
        "collation": {
          "type": "string",
          "description": "RESERVIERT (nicht ausgefuehrt): Server-Collation (nur bei Neuinstallation aenderbar, nicht bei Container!)",
          "examples": [
            "SQL_Latin1_General_CP1_CS_AS",
            "Latin1_General_CI_AS"
          ],
          "x-runtimeStatus": "reserved"
        },
        "memory": {
          "type": "object",
          "description": "SQL-Server-Speichergrenzen",
          "properties": {
            "minMB": {
              "type": "integer",
              "description": "min server memory (MB) - sp_configure",
              "minimum": 0,
              "default": 0,
              "examples": [
                512,
                1024
              ]
            },
            "maxMB": {
              "type": "integer",
              "description": "max server memory (MB) - sp_configure",
              "minimum": 128,
              "examples": [
                2048,
                4096,
                8192
              ]
            }
          },
          "additionalProperties": false,
          "x-runtimeStatus": "executable"
        },
        "tempdb": {
          "$ref": "#/definitions/tempdbConfig",
          "x-runtimeStatus": "executable"
        },
        "maxDop": {
          "type": "integer",
          "description": "max degree of parallelism (0 = alle CPUs)",
          "minimum": 0,
          "maximum": 128,
          "default": 0,
          "x-runtimeStatus": "executable"
        },
        "costThreshold": {
          "type": "integer",
          "description": "cost threshold for parallelism",
          "minimum": 0,
          "default": 5,
          "examples": [
            5,
            25,
            50
          ],
          "x-runtimeStatus": "executable"
        },
        "traceFlags": {
          "type": "array",
          "description": "Globale Trace-Flags (startup)",
          "items": {
            "type": "integer"
          },
          "examples": [
            [
              3226,
              7412,
              1118
            ]
          ],
          "x-runtimeStatus": "executable"
        },
        "spConfigure": {
          "type": "object",
          "description": "Beliebige sp_configure-Einstellungen (Key = Optionsname, Value = Wert)",
          "additionalProperties": {
            "type": "integer"
          },
          "examples": [
            {
              "optimize for ad hoc workloads": 1,
              "remote admin connections": 1
            }
          ],
          "x-runtimeStatus": "executable"
        },
        "defaultPaths": {
          "type": "object",
          "description": "RESERVIERT (nicht ausgefuehrt): Default-Pfade fuer neue Datenbanken und Backups (Registry-Aequivalent)",
          "properties": {
            "data": {
              "type": "string",
              "description": "Default-Pfad fuer Data-Files",
              "x-ui": {
                "label": "Standardpfad fuer Data-Files",
                "help": "Absoluter Zielpfad im SQL-Server-Dateisystem; diese vorbereitete Einstellung wird aktuell nicht ausgefuehrt.",
                "pathKind": "directory",
                "pathBase": "none-absolute-target-path",
                "pathScope": "sql-server-filesystem",
                "mustExistAtPlan": false,
                "createdByRuntime": "not-implemented",
                "defaultReason": "Kein Default im Manifest; ohne Angabe bleibt der SQL-Server-Standard erhalten.",
                "sideEffects": "Reserviertes Feld ohne aktuellen Runtimepfad."
              },
              "examples": [
                "/sqldata",
                "/var/opt/mssql/data",
                "D:\\Data"
              ]
            },
            "log": {
              "type": "string",
              "description": "Default-Pfad fuer Log-Files",
              "x-ui": {
                "label": "Standardpfad fuer Log-Files",
                "help": "Absoluter Zielpfad im SQL-Server-Dateisystem; diese vorbereitete Einstellung wird aktuell nicht ausgefuehrt.",
                "pathKind": "directory",
                "pathBase": "none-absolute-target-path",
