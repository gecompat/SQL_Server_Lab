{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gecompat/SQL_Server_Lab/raw/main/Schemas/ai-runtime-journal.schema.json",
  "title": "SQL Server Lab AI Runtime Journal",
  "type": "object",
  "required": ["contract", "operationId", "runId", "instanceId", "planKey", "status", "lane", "modelKeys", "steps", "cleanupStatus", "startedAt"],
  "properties": {
    "contract": {
      "type": "object",
      "required": ["name", "version"],
      "properties": { "name": { "const": "SqlServerLab.AiRuntimeJournal" }, "version": { "const": "1.0" } },
      "additionalProperties": false
    },
    "operationId": { "type": "string", "format": "uuid" },
    "runId": { "type": "string", "format": "uuid" },
    "instanceId": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" },
    "planKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["PENDING", "RUNNING", "SUCCEEDED", "FAILED", "RECOVERY_REQUIRED"] },
    "lane": { "enum": ["stub", "local", "cloud"] },
    "modelKeys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$" } },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "status": { "enum": ["PENDING", "SUCCEEDED", "FAILED", "COMPENSATED"] },
          "reasonCode": { "type": ["string", "null"], "pattern": "^[A-Z0-9_:.-]+$" }
        },
        "additionalProperties": false
      }
    },
    "cleanupStatus": { "enum": ["NOT_STARTED", "NOT_REQUESTED", "SUCCEEDED", "RECOVERY_REQUIRED"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
