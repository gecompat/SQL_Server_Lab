{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sql-server-lab.local/schemas/hyperv-storage-reconcile-journal.schema.json",
  "title": "SqlServerLab.HyperVStorageReconcileJournal/1.0",
  "type": "object",
  "required": ["ContractVersion", "OperationId", "RunId", "ScopeId", "InstanceId", "Provider", "ChangeClass", "Status", "TargetHash", "Runtime", "Recovery", "UpdatedAt"],
  "properties": {
    "ContractVersion": { "const": "SqlServerLab.HyperVStorageReconcileJournal/1.0" },
    "OperationId": { "type": "string", "format": "uuid" },
    "RunId": { "type": "string", "format": "uuid" },
    "ScopeId": { "type": "string", "format": "uuid" },
    "InstanceId": { "type": "string", "minLength": 1 },
    "Provider": { "const": "hyperv" },
    "ChangeClass": { "enum": ["live", "restart"] },
    "Status": { "enum": ["PREPARED", "HOST_APPLIED", "GUEST_VERIFIED", "STATE_RESTORED", "COMPLETED", "RECOVERY_REQUIRED"] },
    "TargetHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "Runtime": {
      "type": "object",
      "required": ["VMId", "OriginalState"],
      "properties": {
        "VMId": { "type": "string", "minLength": 1 },
        "OriginalState": { "enum": ["Off", "Running"] }
      },
      "additionalProperties": false
    },
    "Recovery": {
      "type": "object",
      "required": ["Status", "Attempts", "ErrorCode", "Errors"],
      "properties": {
        "Status": { "enum": ["RETRY_STORAGE_RECONCILE", "NOT_REQUIRED"] },
        "Attempts": { "type": "integer", "minimum": 0 },
        "ErrorCode": { "type": ["string", "null"] },
        "Errors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "UpdatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
