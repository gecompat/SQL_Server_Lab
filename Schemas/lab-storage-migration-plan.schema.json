{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sql-server-lab.local/schemas/lab-storage-migration-plan.schema.json",
  "title": "SqlServerLab.StorageMigrationPlan/1.0",
  "type": "object",
  "required": ["ContractVersion", "PlanId", "ControllerId", "Status", "Source", "Target", "Inventory", "AffectedRuns", "RequiredActions", "Blockers", "ExecutionImplemented"],
  "properties": {
    "ContractVersion": { "const": "SqlServerLab.StorageMigrationPlan/1.0" },
    "PlanId": { "type": "string", "format": "uuid" },
    "ControllerId": { "type": "string", "format": "uuid" },
    "Status": { "enum": ["READY", "BLOCKED"] },
    "Source": {
      "type": "object",
      "required": ["LocationId", "VolumeId", "LabDataRoot"],
      "properties": { "LocationId": { "type": "string", "format": "uuid" } }
    },
    "Target": {
      "type": "object",
      "required": ["LocationId", "VolumeId", "LabDataParent", "LabDataRoot"],
      "properties": { "LocationId": { "type": "string", "format": "uuid" } }
    },
    "Inventory": {
      "type": "object",
      "required": ["FileCount", "TotalBytes", "RequiredBytes", "AvailableBytes"]
    },
    "AffectedRuns": { "type": "array" },
    "StateRoot": { "type": "string" },
    "HyperVBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ReceiptPath", "ResourceClass", "ResourceId", "ResourceKey", "LocationId", "LabDataRoot", "HyperVResourceRoot", "Valid", "ValidationCode", "MigrationStatus"]
      }
    },
    "HyperVVMConfigurations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["VMId", "VMName", "State", "Paths"],
        "properties": {
          "VMId": { "type": "string" },
          "VMName": { "type": "string", "minLength": 1 },
          "State": { "type": "string", "minLength": 1 },
          "Paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["Kind", "Path", "DestinationPath", "CurrentPath"],
              "properties": {
                "Kind": { "enum": ["Configuration", "Snapshot", "SmartPaging"] },
                "Path": { "type": "string", "minLength": 1 },
                "DestinationPath": { "type": "string", "minLength": 1 },
                "CurrentPath": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "RequiredActions": { "type": "array", "items": { "type": "string" } },
    "Blockers": { "type": "array", "items": { "type": "string" } },
    "ExecutionImplemented": { "const": true }
  },
  "additionalProperties": true
}
