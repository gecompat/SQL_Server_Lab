{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract",
    "revision",
    "policy",
    "tools"
  ],
  "properties": {
    "$schema": {
      "const": "../Schemas/security-tool-catalog.schema.json"
    },
    "contract": {
      "const": "SqlServerLab.SecurityToolCatalog/1.0"
    },
    "revision": {
      "type": "string",
      "pattern": "^(?!latest$|auto$)[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "review",
        "requirePublisherAuthenticity",
        "allowExecution"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^(?!latest$|auto$)[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "roleId",
            "reviewedAt",
            "validUntil",
            "revoked"
          ],
          "properties": {
            "status": {
              "enum": [
                "APPROVED",
                "BLOCKED",
                "RETIRED"
              ]
            },
            "roleId": {
              "type": "string",
              "pattern": "^(?!latest$|auto$)[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
            },
            "reviewedAt": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
            },
            "validUntil": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
            },
            "revoked": {
              "type": "boolean"
            }
          }
        },
        "requirePublisherAuthenticity": {
          "const": true
        },
        "allowExecution": {
          "const": false
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "toolId",
          "variants"
        ],
        "properties": {
          "toolId": {
            "type": "string",
            "pattern": "^(?!latest$|auto$)[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
          },
          "variants": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "variantId",
                "version",
                "purposes",
                "targets",
                "review",
                "license",
                "artifacts"
              ],
              "properties": {
                "variantId": {
                  "type": "string",
                  "pattern": "^(?!latest$|auto$)[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:-[a-z0-9]+)?(?![\\s\\S])"
                },
                "purposes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "purposeId",
                      "sqlLabPurpose"
                    ],
                    "properties": {
                      "purposeId": {
                        "type": "string",
                        "pattern": "^(?!latest$|auto$)[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
                      },
                      "sqlLabPurpose": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    }
                  }
                },
                "targets": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "sqlVersion",
                      "os",
                      "distribution",
                      "osVersion",
                      "architecture",
                      "provider"
                    ],
                    "properties": {
                      "sqlVersion": {
                        "type": "string",
                        "enum": [
                          "2019",
                          "2022",
                          "2025"
                        ]
                      },
                      "os": {
                        "enum": [
                          "windows",
                          "linux"
                        ]
                      },
                      "distribution": {
                        "type": "string",
                        "pattern": "^(?!latest$|auto$)[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
                      },
                      "osVersion": {
                        "type": "string",
                        "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}(?![\\s\\S])"
                      },
                      "architecture": {
                        "enum": [
                          "x64",
                          "arm64"
                        ]
                      },
                      "provider": {
                        "enum": [
                          "docker",
                          "podman",
                          "hyperv"
                        ]
                      }
                    }
                  }
                },
                "review": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "roleId",
                    "reviewedAt",
                    "validUntil",
                    "revoked"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "APPROVED",
                        "BLOCKED",
                        "RETIRED"
                      ]
                    },
                    "roleId": {
                      "type": "string",
                      "pattern": "^(?!latest$|auto$)[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
                    },
                    "reviewedAt": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
                    },
                    "validUntil": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
                    },
                    "revoked": {
                      "type": "boolean"
                    }
                  }
                },
                "license": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sourceUri",
                    "reviewedVersion",
                    "reviewedAt",
                    "localUseAllowed",
                    "redistributionAllowed",
                    "noticeIds"
                  ],
                  "properties": {
                    "sourceUri": {
                      "type": "string",
                      "maxLength": 2048,
                      "pattern": "^https://[a-z0-9][a-z0-9.-]+/[A-Za-z0-9._~/-]+(?![\\s\\S])"
                    },
                    "reviewedVersion": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "reviewedAt": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
                    },
                    "localUseAllowed": {
                      "type": "boolean"
                    },
                    "redistributionAllowed": {
                      "type": "boolean"
                    },
                    "noticeIds": {
                      "type": "array",
                      "minItems": 0,
                      "maxItems": 128,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^(?!latest$|auto$)[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
                      }
                    }
                  }
                },
                "artifacts": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "artifactId",
                      "source",
                      "sha256",
                      "expectedBytes",
                      "maxBytes",
                      "trust"
                    ],
                    "properties": {
                      "artifactId": {
                        "type": "string",
                        "pattern": "^(?!latest$|auto$)[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
                      },
                      "source": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "sourceId",
                          "kind",
                          "uri",
                          "redirectUris"
                        ],
                        "properties": {
                          "sourceId": {
                            "type": "string",
                            "pattern": "^(?!latest$|auto$)[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
                          },
                          "kind": {
                            "enum": [
                              "official-release",
                              "approved-mirror"
                            ]
                          },
                          "uri": {
                            "type": "string",
                            "maxLength": 2048,
                            "pattern": "^https://[a-z0-9][a-z0-9.-]+/[A-Za-z0-9._~/-]+(?![\\s\\S])"
                          },
                          "redirectUris": {
                            "type": "array",
                            "minItems": 0,
                            "maxItems": 0,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "maxLength": 2048,
                              "pattern": "^https://[a-z0-9][a-z0-9.-]+/[A-Za-z0-9._~/-]+(?![\\s\\S])"
                            }
                          }
                        }
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                      },
                      "expectedBytes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1099511627776
                      },
                      "maxBytes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1099511627776
                      },
                      "trust": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "policyRevision",
                          "signatureMethod",
                          "publisherId",
                          "anchorSha256",
                          "hashEvidenceUri",
                          "authenticityEvidenceUri",
                          "timestampPolicy",
                          "revocation"
                        ],
                        "properties": {
                          "policyRevision": {
                            "type": "string",
                            "pattern": "^(?!latest$|auto$)[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
                          },
                          "signatureMethod": {
                            "enum": [
                              "authenticode",
                              "signed-release-inventory",
                              "signed-package-metadata"
                            ]
                          },
                          "publisherId": {
                            "type": "string",
                            "pattern": "^(?!latest$|auto$)[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
                          },
                          "anchorSha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                          },
                          "hashEvidenceUri": {
                            "type": "string",
                            "maxLength": 2048,
                            "pattern": "^https://[a-z0-9][a-z0-9.-]+/[A-Za-z0-9._~/-]+(?![\\s\\S])"
                          },
                          "authenticityEvidenceUri": {
                            "type": "string",
                            "maxLength": 2048,
                            "pattern": "^https://[a-z0-9][a-z0-9.-]+/[A-Za-z0-9._~/-]+(?![\\s\\S])"
                          },
                          "timestampPolicy": {
                            "enum": [
                              "current-validity-only"
                            ]
                          },
                          "revocation": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "checkedAt",
                              "validUntil",
                              "revoked"
                            ],
                            "properties": {
                              "checkedAt": {
                                "type": "string",
                                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
                              },
                              "validUntil": {
                                "type": "string",
                                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
                              },
                              "revoked": {
                                "type": "boolean"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
