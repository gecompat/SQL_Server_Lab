{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sql-server-lab.local/schemas/hyperv-autostart-journal.schema.json",
  "title":"SqlServerLab.HyperVAutoStartJournal/1.0","type":"object",
  "required":["ContractVersion","OperationId","RunId","ScopeId","InstanceId","Provider","Status","Before","Target","Runtime","Recovery","UpdatedAt"],
  "properties":{
    "ContractVersion":{"const":"SqlServerLab.HyperVAutoStartJournal/1.0"},"OperationId":{"type":"string","format":"uuid"},"RunId":{"type":"string","format":"uuid"},"ScopeId":{"type":"string","format":"uuid"},"InstanceId":{"type":"string","minLength":1},"Provider":{"const":"hyperv"},
