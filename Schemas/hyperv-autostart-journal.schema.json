    "Before":{"type":"object","required":["AutoStart","AutomaticStartAction","State","PersistedAutoStart"],"properties":{"AutoStart":{"enum":["on","off"]},"AutomaticStartAction":{"enum":["Start","Nothing"]},"State":{"enum":["Off","Running"]},"PersistedAutoStart":{"enum":["on","off"]}},"additionalProperties":false},
    "Target":{"type":"object","required":["AutoStart","AutomaticStartAction"],"properties":{"AutoStart":{"enum":["on","off"]},"AutomaticStartAction":{"enum":["Start","Nothing"]}},"additionalProperties":false},
    "Runtime":{"type":"object","required":["VMId"],"properties":{"VMId":{"type":"string","minLength":1}},"additionalProperties":false},
    "Recovery":{"type":"object","required":["Status","Attempts","ErrorCode"],"properties":{"Status":{"enum":["RESUME_STATE_COMMIT","NOT_REQUIRED"]},"Attempts":{"type":"integer","minimum":0},"ErrorCode":{"type":["string","null"]}},"additionalProperties":false},"UpdatedAt":{"type":"string","format":"date-time"}
  },"additionalProperties":false
}
