{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sql-server-lab/ai-compute-benchmark-acceptance.schema.json",
  "type": "object",
  "required": ["Contract","Status","ExecutedAtUtc","Platform","InventorySha256","CapabilitySetSha256","CandidateSetSha256","EligibleCandidateCount","BenchmarkCount","SelectionKey","SelectedCandidateId","SelectedBackend","SelectedDevices","SelectedThroughputPerSecond","SelectedP95LatencyMilliseconds","SelectedPeakWorkingSetBytes","RankedCandidates"],
  "properties": {
    "Contract": {"const": "SqlServerLab.AiComputeBenchmarkAcceptance/1.0"},
    "Status": {"const": "PASSED"},
    "ExecutedAtUtc": {"type": "string", "format": "date-time"},
    "Platform": {"enum": ["Windows","Linux"]},
    "InventorySha256": {"$ref": "#/$defs/hash"},
    "CapabilitySetSha256": {"$ref": "#/$defs/hash"},
    "CandidateSetSha256": {"$ref": "#/$defs/hash"},
    "EligibleCandidateCount": {"type": "integer", "minimum": 1, "maximum": 64},
    "BenchmarkCount": {"type": "integer", "minimum": 1, "maximum": 64},
    "SelectionKey": {"$ref": "#/$defs/hash"},
    "SelectedCandidateId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "SelectedBackend": {"enum": ["LlamaCppCpu","LlamaCppCuda","LlamaCppOpenVino","LlamaCppRocm","LlamaCppVulkan","LlamaCppSycl","LlamaCppSnapdragonOpenCl","LlamaCppSnapdragonHexagon"]},
    "SelectedDevices": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/device"}},
    "SelectedThroughputPerSecond": {"type": "number", "exclusiveMinimum": 0},
    "SelectedP95LatencyMilliseconds": {"type": "number", "minimum": 0},
    "SelectedPeakWorkingSetBytes": {"type": "integer", "minimum": 0},
    "RankedCandidates": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/ranked"}}
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "device": {"type": "object", "required": ["Kind","DeviceId"], "properties": {"Kind": {"enum": ["CPU","GPU","NPU"]}, "DeviceId": {"type": "string"}}, "additionalProperties": false},
    "ranked": {"type": "object", "required": ["CandidateId","ThroughputPerSecond","P95LatencyMilliseconds","PeakWorkingSetBytes"], "properties": {"CandidateId": {"type": "string"}, "ThroughputPerSecond": {"type": "number", "exclusiveMinimum": 0}, "P95LatencyMilliseconds": {"type": "number", "minimum": 0}, "PeakWorkingSetBytes": {"type": "integer", "minimum": 0}}, "additionalProperties": false}
  }
}
