{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SqlServerLab.CapabilityEvidenceIndex/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["ContractVersion", "EvidenceBoundary", "Records"],
  "properties": {
    "ContractVersion": { "const": "SqlServerLab.CapabilityEvidenceIndex/1.0" },
    "EvidenceBoundary": { "const": "RECORDED_HISTORY_ONLY" },
    "Records": {
      "type": "array", "maxItems": 128, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["Capability", "Provider", "SqlVersion", "Platform", "Scope", "SourceRevision", "Test", "Result", "Cleanup", "Date", "Reference"],
        "properties": {
          "Capability": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
          "Provider": { "enum": ["none", "docker", "podman", "hyperv", "mixed"] },
          "SqlVersion": { "type": ["string", "null"], "pattern": "^(20[0-9]{2}|2008R2)$" },
          "Platform": { "enum": ["windows", "linux"] },
          "Scope": { "enum": ["STATIC_CONTRACT", "PACKAGE", "NATIVE_LIFECYCLE", "NATIVE_SQL"] },
          "SourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "Test": { "type": "string", "pattern": "^Tests/(Static|Integration)/Invoke-[A-Za-z0-9-]+\\.ps1$" },
          "Result": { "enum": ["PASS", "FAIL", "NOT_EXECUTED", "INFRASTRUCTURE_UNAVAILABLE", "RECOVERY_REQUIRED"] },
          "Cleanup": { "enum": ["PASS", "NOT_REQUIRED", "NOT_EXECUTED", "NOT_RECORDED", "RECOVERY_REQUIRED"] },
          "Date": { "type": "string", "format": "date", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
          "Reference": { "type": "string", "pattern": "^https://github\\.com/gecompat/SQL_Server_Lab/(pull/[0-9]+|actions/runs/[0-9]+|commit/[a-f0-9]{40})$" }
        },
        "allOf": [
          {
            "if": { "properties": { "Result": { "const": "PASS" } } },
            "then": { "properties": { "Cleanup": { "enum": ["PASS", "NOT_REQUIRED"] } } }
          },
          {
            "if": { "properties": { "Scope": { "enum": ["NATIVE_LIFECYCLE", "NATIVE_SQL"] } } },
            "then": { "properties": { "Test": { "pattern": "^Tests/Integration/" }, "Provider": { "not": { "const": "none" } } } },
            "else": { "properties": { "Test": { "pattern": "^Tests/Static/" } } }
          },
          {
            "if": { "properties": { "Scope": { "const": "NATIVE_SQL" } } },
            "then": { "properties": { "SqlVersion": { "type": "string" } } }
          }
        ]
      }
    }
  }
}
