{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/sql-server-lab/ai-shared-gateway-service-secret-receipt.schema.json",
  "type":"object",
  "required":["Contract","Status","EvidenceStatus","GatewayId","GatewayPlanKey","ServicePlanKey","PrincipalKey","SecretSource","ReferenceCount","ReferenceKeys","VerifiedAtUtc","ExpiresAtUtc","VerifiedEvidence","PendingEvidence","ReceiptKey"],
  "properties":{
    "Contract":{"type":"object","required":["Name","Version"],"properties":{"Name":{"const":"SqlServerLab.AiSharedGatewayServiceSecretReceipt"},"Version":{"const":"1.0"}},"additionalProperties":false},
    "Status":{"const":"READY"},"EvidenceStatus":{"const":"CURRENT_PRINCIPAL_SECRETS_RESOLVED"},
    "GatewayId":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,62}$"},
    "GatewayPlanKey":{"$ref":"#/$defs/hash"},"ServicePlanKey":{"$ref":"#/$defs/hash"},"PrincipalKey":{"$ref":"#/$defs/hash"},
    "SecretSource":{"const":"POWERSHELL_SECRET_MANAGEMENT"},"ReferenceCount":{"type":"integer","minimum":1,"maximum":64},
    "ReferenceKeys":{"type":"array","minItems":1,"maxItems":64,"uniqueItems":true,"items":{"$ref":"#/$defs/hash"}},
    "VerifiedAtUtc":{"type":"string","format":"date-time"},"ExpiresAtUtc":{"type":"string","format":"date-time"},
    "VerifiedEvidence":{"type":"array","minItems":4,"maxItems":4,"uniqueItems":true,"items":{"enum":["SECRET_MANAGEMENT_COMMAND_AVAILABLE","ALL_CONSUMER_SECRETS_RESOLVED","ALL_CONSUMER_SECRETS_SECURESTRING","ALL_CONSUMER_SECRETS_GATEWAY_FORMAT"]}},
    "PendingEvidence":{"type":"array","minItems":1,"maxItems":1,"items":{"const":"NONINTERACTIVE_SERVICE_LOGON_SECRET_RESOLUTION"}},
    "ReceiptKey":{"$ref":"#/$defs/hash"}
  },
  "additionalProperties":false,
  "$defs":{"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
}
