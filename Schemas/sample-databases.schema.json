{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gecompat/SQL_Server_Lab/raw/main/Schemas/sample-databases.schema.json",
  "title": "SQL Server Lab Sample Database Catalog",
  "type": "object",
  "required": ["databases", "categories", "cachePolicy"],
  "properties": {
    "$schema": { "type": "string" },
    "_comment": { "type": "string" },
    "databases": {
      "type": "array",
      "items": { "$ref": "#/definitions/database" }
    },
    "categories": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "cachePolicy": { "$ref": "#/definitions/cachePolicy" }
  },
  "additionalProperties": false,
  "definitions": {
    "database": {
      "type": "object",
      "required": [
        "id",
        "name",
        "displayName",
        "description",
        "category",
        "license",
        "source",
        "versions",
        "minSqlVersion",
        "tags"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "category": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "format": "uri" },
        "versions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/definitions/variant" }
        },
        "minSqlVersion": { "type": "string", "pattern": "^\\d{4}$" },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "required": ["url", "sizeMB", "sha256", "compatibility"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "sizeMB": { "type": "number", "minimum": 0 },
        "sha256": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
          ]
        },
        "compatibility": { "type": "integer", "minimum": 80 },
        "type": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "cachePolicy": {
      "type": "object",
      "required": ["location", "strategy", "verifyChecksum", "maxCacheSizeGB", "cleanupAfterDays"],
      "properties": {
        "location": { "type": "string", "minLength": 1 },
        "strategy": { "type": "string", "minLength": 1 },
        "verifyChecksum": { "type": "boolean" },
        "maxCacheSizeGB": { "type": "number", "minimum": 0 },
        "cleanupAfterDays": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
