{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SqlServerLab.BackupLibrary/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["ContractVersion", "Revision", "UpdatedAt", "Backups"],
  "properties": {
    "ContractVersion": { "const": "SqlServerLab.BackupLibrary/1.0" },
    "Revision": { "type": "integer", "minimum": 0 },
    "UpdatedAt": { "type": "string", "format": "date-time" },
    "Backups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["BackupSetId", "Status", "DatabaseName", "Source", "DatabaseMetadata", "Artifact", "Verification", "CreatedAt", "UpdatedAt"],
        "properties": {
          "BackupSetId": { "type": "string", "format": "uuid" },
          "Status": { "enum": ["REUSABLE", "QUARANTINED"] },
          "DatabaseName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$" },
          "Source": {
            "type": "object", "additionalProperties": false,
            "required": ["Provider", "RunId", "InstanceId", "SqlMajorVersion"],
            "properties": {
              "Provider": { "enum": ["docker", "podman", "hyperv"] },
              "RunId": { "type": ["string", "null"] },
              "InstanceId": { "type": ["string", "null"] },
              "SqlMajorVersion": { "type": "string", "pattern": "^[0-9]{2,4}$" }
            }
          },
          "DatabaseMetadata": {
            "type": "object", "additionalProperties": false,
            "required": ["FileCount", "FileStreamFileCount", "FileTableCount", "HasFileStream", "IsEncrypted"],
            "properties": {
              "FileCount": { "type": "integer", "minimum": 1 },
              "FileStreamFileCount": { "type": "integer", "minimum": 0 },
              "FileTableCount": { "type": "integer", "minimum": 0 },
              "HasFileStream": { "type": "boolean" },
              "IsEncrypted": { "type": "boolean" },
              "MigrationExecutionPlanBinding": {
                "type": "object", "additionalProperties": false,
                "required": ["BindingVersion", "ArtifactSha256", "PlanContractVersion", "InventoryContractVersion", "DatabaseName", "ExecutionStatus", "MutationAllowed", "TransferAuthority", "ArtifactScope", "Blockers", "Steps", "GeneratedAt"],
                "properties": {
                  "BindingVersion": { "const": "SqlServerLab.BackupMigrationExecutionPlanBinding/1.0" },
                  "ArtifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "PlanContractVersion": { "const": "SqlServerLab.DatabaseMigrationExecutionPlan/1.0" },
                  "InventoryContractVersion": { "const": "SqlServerLab.DatabaseMigrationDependencyInventory/1.0" },
                  "DatabaseName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$" },
                  "ExecutionStatus": { "enum": ["BLOCKED", "MANUAL_REVIEW_REQUIRED"] },
                  "MutationAllowed": { "const": false },
                  "TransferAuthority": { "const": "NONE" },
                  "ArtifactScope": { "const": "DATABASE_FILES_ONLY" },
                  "Blockers": { "type": "array", "items": { "enum": ["TDE_PROTECTOR_NOT_RESOLVED", "TDE_RECOVERY_EVIDENCE_REQUIRED"] }, "uniqueItems": true },
                  "Steps": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["Category", "Status", "Scope", "RequiredAction", "IncludedInTransfer"], "properties": {
                    "Category": { "enum": ["SERVER_LOGIN_MAPPING", "SQL_AGENT_JOB", "CREDENTIAL_OR_PROXY", "LINKED_SERVER", "SERVER_CONFIGURATION", "TDE_PROTECTOR", "SSISDB", "SSAS"] },
                    "Status": { "enum": ["NOT_REQUIRED", "MANUAL_REQUIRED", "EXTERNAL_REVIEW_REQUIRED", "BLOCKED"] },
                    "Scope": { "enum": ["DATABASE_BOUND", "INSTANCE_WIDE", "EXTERNAL"] },
                    "RequiredAction": { "enum": ["SCRIPT_AND_REMAP", "SCRIPT_OR_RECREATE", "VERIFY_AND_RECREATE", "PROVIDE_TDE_RECOVERY_EVIDENCE", "MANUAL_REVIEW", "EXPORT_SEPARATELY"] },
                    "IncludedInTransfer": { "const": false }
                  } } },
                  "GeneratedAt": { "type": "string", "format": "date-time" }
                }
              },
              "MigrationBoundary": {
                "type": "object", "additionalProperties": false,
                "required": ["DependencyInventoryStatus", "ArtifactScope", "FullInstanceMigration", "ServerObjectsIncluded", "TdeKeyMaterialIncluded", "SecretValuesIncluded", "ExternalServicesIncluded", "DependencyCategories", "Warnings"],
                "properties": {
                  "DependencyInventoryStatus": { "enum": ["NOT_EXECUTED", "SQL_ENGINE_COMPLETE_EXTERNAL_REVIEW_REQUIRED"] },
                  "ArtifactScope": { "const": "DATABASE_FILES_ONLY" },
                  "FullInstanceMigration": { "const": false },
                  "ServerObjectsIncluded": { "const": false },
                  "TdeKeyMaterialIncluded": { "const": false },
                  "SecretValuesIncluded": { "const": false },
                  "ExternalServicesIncluded": { "const": false },
                  "DependencyCategories": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }, "uniqueItems": true },
                  "Warnings": { "type": "array", "minItems": 4, "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }, "uniqueItems": true }
                }
              }
            }
          },
          "Artifact": {
            "type": "object", "additionalProperties": false,
            "required": ["RelativePath", "Sha256", "Bytes"],
            "properties": {
              "RelativePath": { "type": "string", "pattern": "^(?![A-Za-z]:)(?![\\/])(?!.*(?:^|[\\/])\\.\\.(?:[\\/]|$)).+\\.bak$" },
              "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "Bytes": { "type": "integer", "minimum": 1 }
            }
          },
          "Verification": {
            "type": "object", "additionalProperties": false,
            "required": ["BackupChecksum", "RestoreVerifyOnly", "VerifiedAt", "RestoreVerifications"],
            "properties": {
              "BackupChecksum": { "const": true },
              "RestoreVerifyOnly": { "const": true },
              "VerifiedAt": { "type": "string", "format": "date-time" },
              "RestoreVerifications": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["TargetProvider", "TargetSqlMajorVersion", "ContentSha256", "FileStreamContentVerified", "VerifiedAt"],
                  "properties": {
                    "TargetProvider": { "enum": ["docker", "podman", "hyperv"] },
                    "TargetSqlMajorVersion": { "type": "string", "pattern": "^[0-9]{2,4}$" },
                    "ContentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                    "FileStreamContentVerified": { "type": "boolean" },
                    "VerifiedAt": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "CreatedAt": { "type": "string", "format": "date-time" },
          "UpdatedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
