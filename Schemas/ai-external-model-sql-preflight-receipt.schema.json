{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gecompat/SQL_Server_Lab/raw/main/Schemas/ai-external-model-sql-preflight-receipt.schema.json",
  "title": "SQL Server Lab AI External Model SQL Preflight Receipt",
  "type": "object",
  "required": ["Contract","Status","EvidenceStatus","SqlPlanKey","RunId","ScopeId","InstanceId","Provider","BindingKey","DatabaseName","DatabaseGuid","SqlMajorVersion","VerifiedAtUtc","ReceiptKey","VerifiedEvidence","PendingEvidence"],
  "properties": {
    "Contract": {"type":"object","required":["Name","Version"],"properties":{"Name":{"const":"SqlServerLab.AiExternalModelSqlPreflightReceipt"},"Version":{"const":"1.0"}},"additionalProperties":false},
    "Status": {"const":"SQL_PREFLIGHT_VERIFIED"},
    "EvidenceStatus": {"const":"LIVE_SQL_BOUND"},
    "SqlPlanKey": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "RunId": {"type":"string","pattern":"^[a-f0-9-]{36}$"},
    "ScopeId": {"type":"string","pattern":"^[a-f0-9-]{36}$"},
    "InstanceId": {"type":"string","pattern":"^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"},
    "Provider": {"type":"string","minLength":1,"maxLength":32},
    "VMId": {"type":["string","null"],"pattern":"^[a-f0-9-]{36}$"},
    "BindingKey": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "DatabaseName": {"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
    "DatabaseGuid": {"type":"string","pattern":"^[a-f0-9-]{36}$"},
    "SqlMajorVersion": {"const":17},
    "VerifiedAtUtc": {"type":"string","format":"date-time"},
    "ReceiptKey": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "VerifiedEvidence": {"type":"array","minItems":6,"maxItems":6,"uniqueItems":true,"items":{"enum":["SQL_2025_MATCH","DATABASE_ONLINE_READ_WRITE","DATABASE_MASTER_KEY_PRESENT","CONTROL_DATABASE_PERMISSION","CREATE_EXTERNAL_MODEL_PERMISSION","SQL_OBJECT_NAMES_AVAILABLE"]}},
    "PendingEvidence": {"type":"array","minItems":5,"maxItems":5,"uniqueItems":true,"items":{"enum":["SQL_EXTERNAL_MODEL_CREATED","SQL_EMBEDDING_VERIFIED","SQL_RESTART_VERIFIED","ACCELERATOR_RUNTIME_ATTESTATION","SQL_CLEANUP_VERIFIED"]}}
  },
  "allOf": [{"if":{"properties":{"Provider":{"const":"hyperv"}}},"then":{"required":["VMId"],"properties":{"VMId":{"type":"string","pattern":"^[a-f0-9-]{36}$"}}}}],
  "additionalProperties": false
}
