{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sql-server-lab/llama-cpp-model-catalog.schema.json",
  "title": "SQL Server Lab llama.cpp model catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "models"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "family", "purpose", "parameterCountBillions", "quantization", "hardwareTier", "fileName", "sizeBytes", "sha256", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "displayName": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "purpose": { "const": "generation" },
        "parameterCountBillions": { "type": "number", "exclusiveMinimum": 0 },
        "quantization": { "enum": ["Q4_0", "Q4_K_M"] },
        "hardwareTier": { "enum": ["compact", "balanced", "performance"] },
        "fileName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.gguf$" },
        "sizeBytes": { "type": "integer", "minimum": 4 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publisher", "repository", "revision", "downloadUrl", "license", "licenseUrl", "gated"],
          "properties": {
            "publisher": { "const": "Qwen" },
            "repository": { "type": "string", "pattern": "^Qwen/[A-Za-z0-9._-]+$" },
            "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "downloadUrl": { "type": "string", "format": "uri", "pattern": "^https://huggingface\\.co/" },
            "license": { "const": "Apache-2.0" },
            "licenseUrl": { "type": "string", "format": "uri", "pattern": "^https://huggingface\\.co/" },
            "gated": { "const": false }
          }
        }
      }
    }
  }
}
