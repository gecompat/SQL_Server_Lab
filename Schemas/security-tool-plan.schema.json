{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Contract",
    "Status",
    "Blockers",
    "Executable",
    "AuthenticityVerified",
    "Request",
    "CatalogRevision",
    "CatalogSha256",
    "PolicyRevision",
    "ArtifactCount",
    "PlanHash"
  ],
  "properties": {
    "Contract": {
      "const": "SqlServerLab.SecurityToolPlan/1.0"
    },
    "Status": {
      "enum": [
        "PLANNED",
        "BLOCKED"
      ]
    },
    "Blockers": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z_]+(?![\\s\\S])"
      }
    },
    "Executable": {
      "const": false
    },
    "AuthenticityVerified": {
      "const": false
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "toolId",
        "variantId",
        "purposeId",
        "target"
      ],
      "properties": {
        "contract": {
          "const": "SqlServerLab.SecurityToolRequest/1.0"
        },
        "toolId": {
          "type": "string",
          "pattern": "^(?!latest$|auto$)[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
        },
        "variantId": {
          "type": "string",
          "pattern": "^(?!latest$|auto$)[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
        },
        "purposeId": {
          "type": "string",
          "pattern": "^(?!latest$|auto$)[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sqlVersion",
            "os",
            "distribution",
            "osVersion",
            "architecture",
            "provider"
          ],
          "properties": {
            "sqlVersion": {
              "type": "string",
              "enum": [
                "2019",
                "2022",
                "2025"
              ]
            },
            "os": {
              "enum": [
                "windows",
                "linux"
              ]
            },
            "distribution": {
              "type": "string",
              "pattern": "^(?!latest$|auto$)[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
            },
            "osVersion": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}(?![\\s\\S])"
            },
            "architecture": {
              "enum": [
                "x64",
                "arm64"
              ]
            },
            "provider": {
              "enum": [
                "docker",
                "podman",
                "hyperv"
              ]
            }
          }
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "CatalogRevision": {
      "type": "string",
      "pattern": "^(?!latest$|auto$)[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
    },
    "CatalogSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "PolicyRevision": {
      "type": "string",
      "pattern": "^(?!latest$|auto$)[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
    },
    "ArtifactCount": {
      "type": "integer",
      "minimum": 0
    },
    "PlanHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
