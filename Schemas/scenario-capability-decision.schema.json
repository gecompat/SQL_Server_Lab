{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SqlServerLab.InternalScenarioCapabilityDecision/0.1",
  "type": "object", "additionalProperties": false,
  "required": ["ContractVersion", "Status", "ReasonCode", "ScenarioId", "ScenarioVersion", "MissingCapabilityIds", "AlternativeEvidenceIds", "AlternativeEvidenceUsed", "ExecutionPerformed", "RuntimeEvidenceVerified"],
  "properties": {
    "ContractVersion": { "const": "SqlServerLab.InternalScenarioCapabilityDecision/0.1" },
    "Status": { "enum": ["ELIGIBLE", "NOT_EXECUTED", "UNSUPPORTED", "BLOCKED"] },
    "ReasonCode": { "enum": ["DECLARED_CAPABILITIES_AVAILABLE", "SYNTHETIC_ALTERNATIVE_ONLY", "REQUIRED_CAPABILITY_MISSING", "INPUT_INVALID"] },
    "ScenarioId": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "ScenarioVersion": { "type": ["string", "null"], "pattern": "^[1-9][0-9]*\\.[0-9]+$", "maxLength": 16 },
    "MissingCapabilityIds": { "$ref": "#/$defs/ids" },
    "AlternativeEvidenceIds": { "$ref": "#/$defs/ids" },
    "AlternativeEvidenceUsed": { "type": "boolean" },
    "ExecutionPerformed": { "const": false },
    "RuntimeEvidenceVerified": { "const": false }
  },
  "allOf": [
    { "if": { "properties": { "Status": { "const": "BLOCKED" } } }, "then": { "properties": { "ReasonCode": { "const": "INPUT_INVALID" }, "ScenarioId": { "type": "null" }, "ScenarioVersion": { "type": "null" }, "MissingCapabilityIds": { "maxItems": 0 }, "AlternativeEvidenceIds": { "maxItems": 0 }, "AlternativeEvidenceUsed": { "const": false } } } },
    { "if": { "properties": { "Status": { "const": "ELIGIBLE" } } }, "then": { "properties": { "ReasonCode": { "const": "DECLARED_CAPABILITIES_AVAILABLE" }, "MissingCapabilityIds": { "maxItems": 0 }, "AlternativeEvidenceIds": { "maxItems": 0 }, "AlternativeEvidenceUsed": { "const": false } } } },
    { "if": { "properties": { "Status": { "const": "NOT_EXECUTED" } } }, "then": { "properties": { "ReasonCode": { "const": "SYNTHETIC_ALTERNATIVE_ONLY" }, "MissingCapabilityIds": { "minItems": 1 }, "AlternativeEvidenceIds": { "minItems": 1 }, "AlternativeEvidenceUsed": { "const": true } } } },
    { "if": { "properties": { "Status": { "const": "UNSUPPORTED" } } }, "then": { "properties": { "ReasonCode": { "const": "REQUIRED_CAPABILITY_MISSING" }, "MissingCapabilityIds": { "minItems": 1 }, "AlternativeEvidenceIds": { "maxItems": 0 }, "AlternativeEvidenceUsed": { "const": false } } } },
    { "if": { "properties": { "Status": { "enum": ["ELIGIBLE", "NOT_EXECUTED", "UNSUPPORTED"] } } }, "then": { "properties": { "ScenarioId": { "type": "string" }, "ScenarioVersion": { "type": "string" } } } }
  ],
  "$defs": {
    "ids": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" } }
  }
}
