{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SqlServerLab.InternalScenarioContract/0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["ContractVersion", "InternalOnly", "ExecutionImplemented", "Scenario", "Steps", "Evidence", "Outcomes"],
  "properties": {
    "$schema": { "type": "string" },
    "ContractVersion": { "const": "SqlServerLab.InternalScenarioContract/0.1" },
    "InternalOnly": { "const": true },
    "ExecutionImplemented": { "const": false },
    "Scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["Id", "Version", "Kind", "RequiredSqlCapabilities"],
      "properties": {
        "Id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
        "Version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$" },
        "Kind": { "enum": ["QUICK", "DIAGNOSTIC", "PERFORMANCE", "FAULT"] },
        "RequiredSqlCapabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" } }
      }
    },
    "Steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["Id", "Kind", "EvidenceIds", "OutcomeIds"],
        "properties": {
          "Id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "Kind": { "enum": ["WORKFLOW", "PROBE", "ASSERTION"] },
          "EvidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" } },
          "OutcomeIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" } }
        }
      }
    },
    "Evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["Id", "Kind", "Classification"],
        "properties": {
          "Id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "Kind": { "enum": ["OBSERVATION", "MEASUREMENT", "ASSERTION"] },
          "Classification": { "enum": ["SYNTHETIC", "SANITIZED_METADATA"] }
        }
      }
    },
    "Outcomes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["Id", "ExpectedStatus", "EvidenceIds"],
        "properties": {
          "Id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "ExpectedStatus": { "enum": ["PASSED", "FAILED", "NOT_EXECUTED", "UNSUPPORTED"] },
          "EvidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" } }
        }
      }
    }
  }
}
