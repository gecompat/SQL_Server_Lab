{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SqlServerLab.DatabasePackageLibrary/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["ContractVersion", "Revision", "UpdatedAt", "Packages"],
  "properties": {
    "ContractVersion": { "const": "SqlServerLab.DatabasePackageLibrary/1.0" },
    "Revision": { "type": "integer", "minimum": 0 },
    "UpdatedAt": { "type": "string", "format": "date-time" },
    "Packages": { "type": "array", "items": { "$ref": "#/$defs/package" } }
  },
  "$defs": {
    "safePath": { "type": "string", "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+" },
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["DatabasePackageId", "Status", "DatabaseName", "Source", "DatabaseMetadata", "DatabaseFiles", "Objects", "ManifestSha256", "CaptureEvidence", "CreatedAt", "UpdatedAt"],
      "properties": {
        "DatabasePackageId": { "type": "string", "format": "uuid" },
        "Status": { "enum": ["REUSABLE", "QUARANTINED"] },
        "DatabaseName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$" },
        "Source": {
          "type": "object", "additionalProperties": false,
          "required": ["Provider", "RunId", "InstanceId", "SqlMajorVersion"],
          "properties": {
            "Provider": { "enum": ["docker", "podman", "hyperv", "external"] },
            "RunId": { "type": ["string", "null"] }, "InstanceId": { "type": ["string", "null"] },
            "SqlMajorVersion": { "type": "string", "pattern": "^[0-9]{2,4}$" }
          }
        },
        "DatabaseMetadata": {
          "type": "object", "additionalProperties": false,
          "required": ["StateAtCapture", "HasFileStream", "FileStreamInventoryComplete", "IsEncrypted", "TdeKeyEvidenceVerified", "ExternalDependencies"],
          "properties": {
            "StateAtCapture": { "enum": ["OFFLINE", "DETACHED"] },
            "HasFileStream": { "type": "boolean" }, "FileStreamInventoryComplete": { "type": "boolean" },
            "IsEncrypted": { "type": "boolean" }, "TdeKeyEvidenceVerified": { "type": "boolean" },
            "ExternalDependencies": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 128 }, "uniqueItems": true },
            "MigrationBoundary": { "$ref": "#/$defs/migrationBoundary" },
            "MigrationExecutionPlan": { "$ref": "#/$defs/migrationExecutionPlan" }
          }
        },
        "DatabaseFiles": {
          "type": "array", "minItems": 2,
          "items": { "type": "object", "additionalProperties": false, "required": ["LogicalName", "Type", "RelativeRoot", "IsDirectory"],
            "properties": { "LogicalName": { "type": "string", "minLength": 1, "maxLength": 128 }, "Type": { "enum": ["DATA", "LOG", "FILESTREAM"] }, "RelativeRoot": { "$ref": "#/$defs/safePath" }, "IsDirectory": { "type": "boolean" } } }
        },
        "Objects": {
          "type": "array", "minItems": 2,
          "items": { "type": "object", "additionalProperties": false, "required": ["DatabaseFileLogicalName", "RelativePath", "Bytes", "Sha256"],
            "properties": { "DatabaseFileLogicalName": { "type": "string", "minLength": 1 }, "RelativePath": { "$ref": "#/$defs/safePath" }, "Bytes": { "type": "integer", "minimum": 0 }, "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
        },
        "ManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "CaptureEvidence": { "type": "object", "additionalProperties": false, "required": ["AccessMode", "WriterCount", "StateObservedAfterLock", "SourceReleased"],
          "properties": { "AccessMode": { "const": "EXCLUSIVE" }, "WriterCount": { "const": 0 }, "StateObservedAfterLock": { "const": true }, "SourceReleased": { "type": "boolean" } } },
        "CreatedAt": { "type": "string", "format": "date-time" }, "UpdatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "migrationBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["DependencyInventoryStatus", "ArtifactScope", "FullInstanceMigration", "ServerObjectsIncluded", "TdeKeyMaterialIncluded", "SecretValuesIncluded", "ExternalServicesIncluded", "DependencyCategories", "Warnings"],
      "properties": {
        "DependencyInventoryStatus": { "enum": ["NOT_EXECUTED", "SQL_ENGINE_COMPLETE_EXTERNAL_REVIEW_REQUIRED"] },
        "ArtifactScope": { "const": "DATABASE_FILES_ONLY" },
        "FullInstanceMigration": { "const": false },
        "ServerObjectsIncluded": { "const": false },
        "TdeKeyMaterialIncluded": { "const": false },
        "SecretValuesIncluded": { "const": false },
        "ExternalServicesIncluded": { "const": false },
        "DependencyCategories": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }, "uniqueItems": true },
        "Warnings": { "type": "array", "minItems": 4, "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }, "uniqueItems": true }
      }
    },
    "migrationExecutionPlan": {
      "type": "object", "additionalProperties": false,
      "required": ["ContractVersion", "InventoryContractVersion", "DatabaseName", "ExecutionStatus", "MutationAllowed", "TransferAuthority", "ArtifactScope", "Blockers", "Steps", "GeneratedAt"],
      "properties": {
        "ContractVersion": { "const": "SqlServerLab.DatabaseMigrationExecutionPlan/1.0" },
        "InventoryContractVersion": { "const": "SqlServerLab.DatabaseMigrationDependencyInventory/1.0" },
        "DatabaseName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$" },
        "ExecutionStatus": { "enum": ["BLOCKED", "MANUAL_REVIEW_REQUIRED"] },
        "MutationAllowed": { "const": false },
        "TransferAuthority": { "const": "NONE" },
        "ArtifactScope": { "const": "DATABASE_FILES_ONLY" },
        "Blockers": { "type": "array", "items": { "enum": ["TDE_PROTECTOR_NOT_RESOLVED", "TDE_RECOVERY_EVIDENCE_REQUIRED"] }, "uniqueItems": true },
        "Steps": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["Category", "Status", "Scope", "RequiredAction", "IncludedInTransfer"], "properties": {
          "Category": { "enum": ["SERVER_LOGIN_MAPPING", "SQL_AGENT_JOB", "CREDENTIAL_OR_PROXY", "LINKED_SERVER", "SERVER_CONFIGURATION", "TDE_PROTECTOR", "SSISDB", "SSAS"] },
          "Status": { "enum": ["NOT_REQUIRED", "MANUAL_REQUIRED", "EXTERNAL_REVIEW_REQUIRED", "BLOCKED"] },
          "Scope": { "enum": ["DATABASE_BOUND", "INSTANCE_WIDE", "EXTERNAL"] },
          "RequiredAction": { "enum": ["SCRIPT_AND_REMAP", "SCRIPT_OR_RECREATE", "VERIFY_AND_RECREATE", "PROVIDE_TDE_RECOVERY_EVIDENCE", "MANUAL_REVIEW", "EXPORT_SEPARATELY"] },
          "IncludedInTransfer": { "const": false }
        } } },
        "GeneratedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
