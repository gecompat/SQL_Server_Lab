{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sql-server-lab.local/schemas/container-autostart-journal.schema.json",
  "title": "SqlServerLab.ContainerAutoStartJournal/1.0",
  "type": "object",
  "required": ["ContractVersion", "OperationId", "RunId", "ScopeId", "InstanceId", "Provider", "Status", "Before", "Target", "Runtime", "PreviousConnection", "PreviousDesiredState", "Recovery", "UpdatedAt"],
  "properties": {
    "ContractVersion": { "const": "SqlServerLab.ContainerAutoStartJournal/1.0" },
    "OperationId": { "type": "string", "format": "uuid" },
    "RunId": { "type": "string", "format": "uuid" },
    "ScopeId": { "type": "string", "format": "uuid" },
    "InstanceId": { "type": "string", "minLength": 1 },
    "Provider": { "enum": ["docker", "podman"] },
    "Status": { "enum": ["PREPARED", "POLICY_MUTATED", "STATE_COMMITTED", "COMPLETED", "RECOVERY_REQUIRED"] },
    "Before": {
      "type": "object", "required": ["AutoStart", "RestartPolicy", "Running", "PersistedAutoStart"],
      "properties": {
        "AutoStart": { "enum": ["on", "off"] }, "RestartPolicy": { "type": "string" },
        "Running": { "type": "boolean" }, "PersistedAutoStart": { "enum": ["on", "off"] }
      }, "additionalProperties": false
    },
    "Target": {
      "type": "object", "required": ["AutoStart", "RestartPolicy"],
      "properties": { "AutoStart": { "enum": ["on", "off"] }, "RestartPolicy": { "enum": ["unless-stopped", "no"] } },
      "additionalProperties": false
    },
    "Runtime": {
      "type": "object", "required": ["OriginalId"],
      "properties": { "OriginalId": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false
    },
    "PreviousConnection": { "type": "object" }, "PreviousDesiredState": { "type": "object" },
    "Recovery": {
      "type": "object", "required": ["Status", "Attempts", "ErrorCode"],
      "properties": { "Status": { "enum": ["RESUME_STATE_COMMIT", "NOT_REQUIRED"] }, "Attempts": { "type": "integer", "minimum": 0 }, "ErrorCode": { "type": ["string", "null"] } },
      "additionalProperties": false
    },
    "UpdatedAt": { "type": "string", "format": "date-time" }
  }, "additionalProperties": false
}
