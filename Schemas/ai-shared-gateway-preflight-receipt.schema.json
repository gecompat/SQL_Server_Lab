{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/sql-server-lab/ai-shared-gateway-preflight-receipt.schema.json",
  "type":"object","required":["Contract","Status","EvidenceStatus","PlanKey","RuntimeSha256","ModelSha256","ServerCertificateSha256","CertificateAuthoritySha256","CertificateNotBeforeUtc","CertificateNotAfterUtc","VerifiedAtUtc","VerifiedEvidence","PendingEvidence","ReceiptKey"],
  "properties":{
