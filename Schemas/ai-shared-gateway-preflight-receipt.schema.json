    "PlanKey":{"$ref":"#/$defs/hash"},"RuntimeSha256":{"$ref":"#/$defs/hash"},"ModelSha256":{"$ref":"#/$defs/hash"},"ServerCertificateSha256":{"$ref":"#/$defs/hash"},"CertificateAuthoritySha256":{"$ref":"#/$defs/hash"},
    "CertificateNotBeforeUtc":{"type":"string","format":"date-time"},"CertificateNotAfterUtc":{"type":"string","format":"date-time"},"VerifiedAtUtc":{"type":"string","format":"date-time"},
