{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/sql-server-lab/ai-shared-gateway-upstream-receipt.schema.json",
  "type":"object","required":["Contract","Status","EvidenceStatus","GatewayId","PlanKey","StorageReceiptKey","UpstreamBindingKey","Backend","RuntimeModel","Dimension","HttpStatus","DurationMilliseconds","VerifiedAtUtc","VerifiedEvidence","PendingEvidence","ReceiptKey"],
  "properties":{
