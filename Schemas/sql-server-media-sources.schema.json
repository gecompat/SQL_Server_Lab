{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gecompat/SQL_Server_Lab/raw/main/Schemas/sql-server-media-sources.schema.json",
  "title": "SQL Server Lab Media Source Catalog",
  "type": "object",
  "required": ["catalogMetadata", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "catalogMetadata": {
      "type": "object",
      "required": ["lastVerified", "maintainedBy", "scope", "sources"],
      "properties": {
        "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "maintainedBy": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/entry" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "nullableUri": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "uri" }
      ]
    },
    "nullableString": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "nullableInteger": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 1 }
      ]
    },
    "nullableSha256": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      ]
    },
    "nullableSha1": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      ]
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "displayName",
        "version",
        "edition",
        "mediaKind",
        "architecture",
        "language",
        "acquisition",
        "sourceStatus",
        "downloadUrl",
        "referenceUrl",
        "originalMicrosoftUrl",
        "targetRelativePath",
        "expectedBytes",
        "expectedSha256",
        "expectedSha1",
        "productVersion",
        "automatable",
        "note"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^sql-server-[a-z0-9.-]+$" },
        "displayName": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^(?:\\d{4}(?:R2)?|\\d+\\.\\d+)$" },
        "edition": { "type": "string", "minLength": 1 },
        "mediaKind": {
          "type": "string",
          "enum": ["ISO", "BOOTSTRAPPER", "SELF_EXTRACTING_EXE", "LICENSED_MEDIA"]
        },
        "architecture": { "$ref": "#/definitions/nullableString" },
        "language": { "$ref": "#/definitions/nullableString" },
        "acquisition": {
          "type": "string",
          "enum": [
            "DIRECT_MICROSOFT_DOWNLOAD",
            "MICROSOFT_REDIRECT",
            "ARCHIVE_FALLBACK_VERIFIED",
            "MANUAL_PORTAL_SELECTION",
            "MANUAL_LICENSED_MEDIA"
          ]
        },
        "sourceStatus": {
          "type": "string",
          "enum": ["ACTIVE", "ORIGINAL_URL_RETIRED", "MANUAL_ONLY"]
        },
        "downloadUrl": { "$ref": "#/definitions/nullableUri" },
        "referenceUrl": { "$ref": "#/definitions/nullableUri" },
        "originalMicrosoftUrl": { "$ref": "#/definitions/nullableUri" },
        "targetRelativePath": { "type": "string", "pattern": "^SQL/[^\\r\\n]+$" },
        "expectedBytes": { "$ref": "#/definitions/nullableInteger" },
        "expectedSha256": { "$ref": "#/definitions/nullableSha256" },
        "expectedSha1": { "$ref": "#/definitions/nullableSha1" },
        "productVersion": { "$ref": "#/definitions/nullableString" },
        "automatable": { "type": "boolean" },
        "note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
