{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gecompat/SQL_Server_Lab/raw/main/Schemas/ai-external-model-sql-apply-journal.schema.json",
  "title": "SQL Server Lab AI External Model SQL Apply Journal",
  "type": "object",
  "required": ["Contract","OperationId","Status","SqlPlanKey","PreflightReceiptKey","BindingKey","RunId","ScopeId","InstanceId","Provider","DatabaseName","DatabaseGuid","OwnershipTableName","ExternalModelName","CredentialName","Recovery","UpdatedAtUtc"],
  "properties": {
    "Contract": {"const":"SqlServerLab.AiExternalModelSqlApplyJournal/1.0"},
    "OperationId": {"type":"string","pattern":"^[a-f0-9-]{36}$"},
    "Status": {"enum":["APPLY_PENDING","APPLIED","CLEANUP_PENDING","CLEANED"]},
    "SqlPlanKey": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "PreflightReceiptKey": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "BindingKey": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "RunId": {"type":"string","pattern":"^[a-f0-9-]{36}$"},
    "ScopeId": {"type":"string","pattern":"^[a-f0-9-]{36}$"},
    "InstanceId": {"type":"string","pattern":"^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"},
    "Provider": {"type":"string","minLength":1,"maxLength":32},
    "DatabaseName": {"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
    "DatabaseGuid": {"type":"string","pattern":"^[a-f0-9-]{36}$"},
    "OwnershipTableName": {"type":"string","pattern":"^SqlServerLabAiOwner_[a-f0-9]{24}$"},
    "ExternalModelName": {"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
    "CredentialName": {"type":"string","pattern":"^https://[^/]+$"},
    "Recovery": {"enum":["RESUME_AND_VERIFY_SQL_RECEIPT","RESUME_AND_VERIFY_SQL_CLEANUP","NOT_REQUIRED"]},
    "UpdatedAtUtc": {"type":"string","format":"date-time"}
  },
  "additionalProperties": false
}
