{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gecompat/SQL_Server_Lab/raw/main/Schemas/cu-status-sources.schema.json",
  "title": "SQL Server Lab CU Status Sources",
  "type": "object",
  "required": ["contract", "sources"],
  "properties": {
    "$schema": { "type": "string" },
    "contract": { "const": "SqlServerLab.CuStatusSources/1.0" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "url", "allowedHosts", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "url": { "type": "string", "format": "uri" },
          "allowedHosts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" }
          },
          "excludedUpdates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["version", "update", "kb", "reason"],
              "properties": {
                "version": { "type": "string", "pattern": "^\\d{4}$" },
                "update": { "type": "string", "pattern": "^CU[1-9]\\d*$" },
                "kb": { "type": "string", "pattern": "^KB\\d+$" },
                "reason": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "description": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
