{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sql-server-lab/ai-compute-candidate-set.schema.json",
  "type": "object",
  "required": ["Contract","Status","InventorySha256","Candidates","CandidateSetSha256"],
  "properties": {
    "Contract": {"const":"SqlServerLab.AiComputeCandidateSet/1.0"},
    "Status": {"const":"COMPLETE"},
    "InventorySha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "Candidates": {"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/candidate"}},
    "CandidateSetSha256": {"type":"string","pattern":"^[a-f0-9]{64}$"}
  },
  "additionalProperties": false,
  "$defs": {
    "device": {"type":"object","required":["Kind","DeviceId"],"properties":{"Kind":{"enum":["CPU","GPU","NPU"]},"DeviceId":{"type":"string","pattern":"^(cpu|gpu|npu):[a-z0-9][a-z0-9._-]{0,63}:[a-z0-9][a-z0-9._-]{0,63}:[0-9]+$"}},"additionalProperties":false},
    "candidate": {"type":"object","required":["CandidateId","Backend","RuntimeSha256","Devices","Eligible","Blockers"],"properties":{"CandidateId":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,127}$"},"Backend":{"enum":["LlamaCppCuda","LlamaCppOpenVino","LlamaCppRocm","LlamaCppSnapdragonOpenCl","LlamaCppSnapdragonHexagon","OpenVinoModelServer","Ollama"]},"RuntimeSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"Devices":{"type":"array","minItems":1,"maxItems":16,"items":{"$ref":"#/$defs/device"}},"Eligible":{"type":"boolean"},"Blockers":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,127}$"}}},"additionalProperties":false}
  }
}
