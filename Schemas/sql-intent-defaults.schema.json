{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SQL Server Lab defaults for selected SQL intents",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "collation"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "collation": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,128}$" }
  }
}
