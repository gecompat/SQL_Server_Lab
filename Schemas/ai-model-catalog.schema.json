{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gecompat/SQL_Server_Lab/raw/main/Schemas/ai-model-catalog.schema.json",
  "title": "SQL Server Lab AI Model Catalog",
  "type": "object",
  "required": ["contract", "models"],
  "properties": {
    "$schema": { "type": "string" },
    "contract": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "SqlServerLab.AiModelCatalog" },
        "version": { "const": "1.0" }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "provider", "lane", "purpose", "model", "status", "identityPolicy", "license", "source"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$" },
          "provider": { "const": "ollama" },
          "lane": { "enum": ["local", "cloud"] },
          "purpose": { "enum": ["embedding", "generation"] },
          "model": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]{1,127}$" },
          "dimension": { "type": "integer", "minimum": 1, "maximum": 1998 },
          "status": { "enum": ["PLANNED", "SUPPORTED", "BLOCKED"] },
          "minimumOllamaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "identityPolicy": { "enum": ["LIVE_MANIFEST_DIGEST_REQUIRED", "CLOUD_MODEL_IDENTITY_REQUIRED"] },
          "estimatedSizeBytes": { "type": "integer", "minimum": 1 },
          "license": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "allOf": [
          { "if": { "properties": { "purpose": { "const": "embedding" } } }, "then": { "required": ["dimension"] } },
          { "if": { "properties": { "lane": { "const": "local" } } }, "then": { "required": ["minimumOllamaVersion", "estimatedSizeBytes"] } }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
