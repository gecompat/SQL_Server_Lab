{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SqlServerLab.DatabaseMigrationDependencyInventory/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["ContractVersion", "DatabaseName", "Source", "ObservationStatus", "Database", "Dependencies", "MigrationBoundary", "ObservedAt"],
  "properties": {
    "ContractVersion": { "const": "SqlServerLab.DatabaseMigrationDependencyInventory/1.0" },
    "DatabaseName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$" },
    "Source": {
      "type": "object", "additionalProperties": false,
      "required": ["Provider", "RunId", "InstanceId", "SqlMajorVersion"],
      "properties": {
        "Provider": { "enum": ["docker", "podman", "hyperv", "external"] },
        "RunId": { "type": ["string", "null"] },
        "InstanceId": { "type": ["string", "null"] },
        "SqlMajorVersion": { "type": "string", "pattern": "^[0-9]{2,4}$" }
      }
    },
    "ObservationStatus": { "const": "SQL_ENGINE_COMPLETE_EXTERNAL_REVIEW_REQUIRED" },
    "Database": {
      "type": "object", "additionalProperties": false,
      "required": ["Containment", "IsEncrypted", "EncryptionState", "EncryptorType", "TdeRecoveryEvidenceVerified"],
      "properties": {
        "Containment": { "enum": ["NONE", "PARTIAL", "CONTAINED", "UNKNOWN"] },
        "IsEncrypted": { "type": "boolean" },
        "EncryptionState": { "enum": ["NOT_ENCRYPTED", "UNENCRYPTED", "ENCRYPTION_IN_PROGRESS", "ENCRYPTED", "KEY_CHANGE_IN_PROGRESS", "DECRYPTION_IN_PROGRESS", "PROTECTION_CHANGE_IN_PROGRESS", "UNKNOWN"] },
        "EncryptorType": { "enum": ["NONE", "CERTIFICATE", "ASYMMETRIC_KEY", "UNKNOWN"] },
        "TdeRecoveryEvidenceVerified": { "type": "boolean" }
      }
    },
    "Dependencies": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["Category", "Status", "Count", "Scope", "RequiredAction", "IncludedInDatabaseArtifact"],
        "properties": {
          "Category": { "enum": ["SERVER_LOGIN_MAPPING", "SQL_AGENT_JOB", "CREDENTIAL_OR_PROXY", "LINKED_SERVER", "SERVER_CONFIGURATION", "TDE_PROTECTOR", "SSISDB", "SSAS"] },
          "Status": { "enum": ["DETECTED", "NOT_DETECTED", "NOT_OBSERVABLE"] },
          "Count": { "type": ["integer", "null"], "minimum": 0 },
          "Scope": { "enum": ["DATABASE_BOUND", "INSTANCE_WIDE", "EXTERNAL"] },
          "RequiredAction": { "enum": ["SCRIPT_AND_REMAP", "SCRIPT_OR_RECREATE", "VERIFY_AND_RECREATE", "PROVIDE_TDE_RECOVERY_EVIDENCE", "MANUAL_REVIEW", "EXPORT_SEPARATELY"] },
          "IncludedInDatabaseArtifact": { "const": false }
        }
      }
    },
    "MigrationBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["ArtifactScope", "FullInstanceMigration", "ServerObjectsIncluded", "TdeKeyMaterialIncluded", "SecretValuesIncluded", "ExternalServicesIncluded", "PortableRestoreStatus", "Blockers", "Warnings"],
      "properties": {
        "ArtifactScope": { "const": "DATABASE_ONLY" },
        "FullInstanceMigration": { "const": false },
        "ServerObjectsIncluded": { "const": false },
        "TdeKeyMaterialIncluded": { "const": false },
        "SecretValuesIncluded": { "const": false },
        "ExternalServicesIncluded": { "const": false },
        "PortableRestoreStatus": { "enum": ["BLOCKED", "MANUAL_REVIEW"] },
        "Blockers": { "type": "array", "items": { "enum": ["TDE_PROTECTOR_NOT_RESOLVED", "TDE_RECOVERY_EVIDENCE_REQUIRED"] }, "uniqueItems": true },
        "Warnings": { "type": "array", "minItems": 4, "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }, "uniqueItems": true }
      }
    },
    "ObservedAt": { "type": "string", "format": "date-time" }
  }
}
