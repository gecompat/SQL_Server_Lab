{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sql-server-lab.local/schemas/hyperv-external-runtime-reconcile-journal.schema.json",
  "title": "SqlServerLab.HyperVExternalRuntimeReconcileJournal/1.0",
  "type": "object",
  "required": [
    "ContractVersion",
    "OperationId",
    "RunId",
    "ScopeId",
    "InstanceId",
    "Provider",
    "ChangeClass",
    "Status",
    "TargetHash",
    "Runtime",
    "PreviousPlanKeys",
    "DesiredPlanKeys",
    "Additions",
    "Recovery",
    "UpdatedAt"
  ],
  "properties": {
    "ContractVersion": { "const": "SqlServerLab.HyperVExternalRuntimeReconcileJournal/1.0" },
    "OperationId": { "type": "string", "format": "uuid" },
    "RunId": { "type": "string", "format": "uuid" },
    "ScopeId": { "type": "string", "format": "uuid" },
    "InstanceId": { "type": "string", "minLength": 1 },
    "Provider": { "const": "hyperv" },
    "ChangeClass": { "const": "reprovision" },
    "Status": {
      "enum": ["PREPARED", "INSTALLING", "VERIFIED", "DESIRED_STATE_UPDATED", "COMPLETED", "RECOVERY_REQUIRED"]
    },
    "TargetHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "Runtime": {
      "type": "object",
      "required": ["VMId"],
      "properties": { "VMId": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "PreviousPlanKeys": { "$ref": "#/$defs/planKeys" },
    "DesiredPlanKeys": { "$ref": "#/$defs/planKeys" },
    "Additions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["SoftwareId", "PlanKey", "Status"],
        "properties": {
          "SoftwareId": { "enum": ["sql-python", "sql-r", "sql-java"] },
          "PlanKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "Status": { "enum": ["PENDING", "APPLYING", "APPLIED"] }
        },
        "additionalProperties": false
      }
    },
    "Recovery": {
      "type": "object",
      "required": ["Status", "Attempts", "ErrorCode", "Errors"],
      "properties": {
        "Status": { "enum": ["RETRY_HYPERV_EXTERNAL_RUNTIME_RECONCILE", "NOT_REQUIRED"] },
        "Attempts": { "type": "integer", "minimum": 0 },
        "ErrorCode": { "type": ["string", "null"] },
        "Errors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "UpdatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "planKeys": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }
  },
  "additionalProperties": false
}
