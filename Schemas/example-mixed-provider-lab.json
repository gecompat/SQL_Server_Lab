{
  "$schema": "./lab-manifest.schema.json",
  "name": "mixed-container-providers",
  "description": "Zwei unabhaengige SQL-Server-Instanzen in einem Run mit Docker und Podman.",
  "instances": [
    {
      "id": "docker-primary",
      "version": "2022",
      "provider": "docker",
      "profile": "compact"
    },
    {
      "id": "podman-secondary",
      "version": "2022",
      "provider": "podman",
      "profile": "compact"
    }
  ]
}
