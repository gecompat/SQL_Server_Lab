{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sql-server-lab.local/schemas/persistent-storage-artifact-sync-result.schema.json",
  "title": "SqlServerLab.PersistentStorageArtifactSyncResult/1.0",
  "type": "object",
  "required": [
    "ContractVersion",
    "Status",
    "ArtifactType",
    "ArtifactId",
    "Changed",
    "WouldChange",
    "PersistentStorageId",
    "CatalogRevision"
  ],
  "properties": {
    "ContractVersion": { "const": "SqlServerLab.PersistentStorageArtifactSyncResult/1.0" },
    "Status": { "enum": ["PLANNED", "CANCELLED", "SYNCED", "NO_CHANGE"] },
    "ArtifactType": { "enum": ["BACKUP_SET", "DATABASE_PACKAGE", "EXCHANGE_WORKSPACE"] },
    "ArtifactId": { "type": "string", "format": "uuid" },
    "Changed": { "type": "boolean" },
    "WouldChange": { "type": "boolean" },
    "PersistentStorageId": { "type": ["string", "null"], "format": "uuid" },
    "CatalogRevision": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
