{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sql-server-lab/ai-compute-benchmark-set.schema.json",
  "type": "object",
  "required": ["Contract", "Status", "Selection", "Benchmarks"],
  "properties": {
    "Contract": {"const": "SqlServerLab.AiComputeBenchmarkSet/1.0"},
    "Status": {"const": "SELECTED"},
    "Selection": {"$ref": "#/$defs/selection"},
    "Benchmarks": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/receipt"}}
  },
  "additionalProperties": false,
  "$defs": {
    "device": {
      "type": "object",
      "required": ["Kind", "DeviceId"],
      "properties": {"Kind": {"enum": ["CPU", "GPU", "NPU"]}, "DeviceId": {"type": "string"}},
      "additionalProperties": false
    },
    "ranked": {
      "type": "object",
      "required": ["CandidateId", "ThroughputPerSecond", "P95LatencyMilliseconds", "PeakWorkingSetBytes", "SuccessfulIterations", "TotalIterations"],
      "properties": {
        "CandidateId": {"type": "string"},
        "ThroughputPerSecond": {"type": "number", "exclusiveMinimum": 0},
        "P95LatencyMilliseconds": {"type": "number", "minimum": 0},
        "PeakWorkingSetBytes": {"type": "integer", "minimum": 0},
        "SuccessfulIterations": {"type": "integer", "minimum": 3},
        "TotalIterations": {"type": "integer", "minimum": 3}
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": ["Contract", "Status", "SelectionMode", "CandidateId", "Backend", "Devices", "RuntimeSha256", "WorkloadKey", "ModelSha256", "BenchmarkProfileSha256", "InventorySha256", "SelectedBenchmark", "RankedCandidates", "ExcludedCandidates", "SelectionKey"],
      "properties": {
        "Contract": {"const": "SqlServerLab.AiComputeSelection/1.0"},
        "Status": {"const": "SELECTED"},
        "SelectionMode": {"const": "AUTO_FASTEST"},
        "CandidateId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "Backend": {"enum": ["LlamaCppCpu", "LlamaCppCuda", "LlamaCppOpenVino", "LlamaCppRocm", "LlamaCppVulkan", "LlamaCppSycl", "LlamaCppSnapdragonOpenCl", "LlamaCppSnapdragonHexagon", "OpenVinoModelServer", "Ollama"]},
        "Devices": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/device"}},
        "RuntimeSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "WorkloadKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "ModelSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "BenchmarkProfileSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "InventorySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "SelectedBenchmark": {"$ref": "#/$defs/ranked"},
        "RankedCandidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ranked"}},
        "ExcludedCandidates": {"type": "array", "items": {"type": "object", "required": ["CandidateId", "Blockers"], "properties": {"CandidateId": {"type": "string"}, "Blockers": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false}},
        "SelectionKey": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": ["Contract", "CandidateId", "WorkloadKey", "ModelSha256", "BenchmarkProfileSha256", "InventorySha256", "RuntimeSha256", "ThroughputPerSecond", "P95LatencyMilliseconds", "PeakWorkingSetBytes", "SuccessfulIterations", "TotalIterations", "EvidenceStatus"],
      "properties": {
        "Contract": {"const": "SqlServerLab.AiComputeBenchmark/1.0"},
        "CandidateId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "WorkloadKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "ModelSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "BenchmarkProfileSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "InventorySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "RuntimeSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "ThroughputPerSecond": {"type": "number", "exclusiveMinimum": 0},
        "P95LatencyMilliseconds": {"type": "number", "exclusiveMinimum": 0},
        "PeakWorkingSetBytes": {"type": "integer", "minimum": 0},
        "SuccessfulIterations": {"type": "integer", "minimum": 3},
        "TotalIterations": {"type": "integer", "minimum": 3},
        "EvidenceStatus": {"const": "BENCHMARK_VERIFIED"}
      },
      "additionalProperties": false
    }
  }
}
