{
  "name": "podman",
  "displayName": "Podman Containers",
  "description": "Container-basierte SQL-Server-Instanzen via Podman; allgemeine Labs unterstuetzen rootless Betrieb, SQL Server 2022 External Runtimes erfordern rootful Linux mit cgroup v1.",
  "capabilities": [
    "linux",
    "multi-instance",
    "fast-start",
    "port-mapping",
    "volume-mounts",
    "managed-lab-network",
    "nat-network",
    "isolated-network",
    "resource-limits",
    "rootless",
    "software-catalog-planning",
    "derived-image-build",
    "sql-external-runtime"
  ],
  "limitations": [
    "no-gui",
    "no-windows-os",
    "limited-io-simulation",
    "limited-network-simulation",
    "external-runtime-requires-rootful-linux-cgroup-v1"
  ],
  "detectionCommand": "podman info",
  "healthCheck": "podman ps --format '{{.ID}}'",
  "module": "PodmanProvider.ps1",
  "defaultPort": 14330,
  "portRange": {
    "min": 14330,
    "max": 14399
  },
  "labels": {
    "prefix": "sql-server-lab",
    "runId": "sql-server-lab.run-id",
    "scopeId": "sql-server-lab.scope-id",
    "instanceId": "sql-server-lab.instance-id"
  },
  "requirements": {
    "command": "podman",
    "minVersion": "4.0"
  }
}
