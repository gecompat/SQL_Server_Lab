{
  "name": "podman",
  "displayName": "Podman (Rootless Containers)",
  "description": "Container-basierte SQL-Server-Instanzen via Podman, einschliesslich rootless Betrieb.",
  "capabilities": [
    "linux",
    "multi-instance",
    "fast-start",
    "port-mapping",
    "volume-mounts",
    "managed-lab-network",
    "isolated-network",
    "resource-limits",
    "rootless"
  ],
  "limitations": [
    "no-gui",
    "no-windows-os",
    "limited-io-simulation",
    "limited-network-simulation"
  ],
  "detectionCommand": "podman info",
  "healthCheck": "podman ps --format '{{.ID}}'",
  "module": "PodmanProvider.ps1",
  "defaultPort": 14330,
  "portRange": {
    "min": 14330,
    "max": 14399
  },
  "labels": {
    "prefix": "sql-server-lab",
    "runId": "sql-server-lab.run-id",
    "scopeId": "sql-server-lab.scope-id",
    "instanceId": "sql-server-lab.instance-id"
  },
  "requirements": {
    "command": "podman",
    "minVersion": "4.0"
  }
}
